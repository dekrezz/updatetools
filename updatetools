# ===========================================================================
# Dispatch
# ===========================================================================
# Single-instance lock. Two concurrent runs collide on Homebrew's download lock:
# one grabs the .incomplete bottle, the other dies "A `brew upgrade` process has
# already locked ...". Refuse a second run; reclaim a stale lock whose owner is
# gone. mkdir is atomic, so this is race-free without needing flock (absent on macOS).
#
# The pid file alone isn't enough: a run whose lock got reclaimed (stale pid file,
# crash, closed terminal) stays alive and keeps painting the terminal, so two
# dashboards end up fighting over the same screen. Scan for a live sibling first.
LOCK_BASE="${TMPDIR:-/tmp}/updatetools.lock"
# Match only processes actually *running* this script (argv[1]'s basename), not
# any command line that merely mentions the path (an editor, a grep, a wrapper).
live_sibling() {
  local p args script
  for p in $(pgrep -x bash 2>/dev/null); do
    [ "$p" = "$$" ] && continue
    args="$(ps -o args= -p "$p" 2>/dev/null)"
    script="$(printf '%s\n' "$args" | awk '{print $2}')"
    [ "${script##*/}" = "updatetools" ] && { printf '%s\n' "$p"; return 0; }
  done
  return 1
}
other="$(live_sibling)"
if [ -n "$other" ]; then
  echo "updatetools is already running (PID $other) — refusing to start a second run."
  echo "Two dashboards would render over each other; kill it first:  kill $other"
  exit 1
fi
if mkdir "$LOCK_BASE" 2>/dev/null; then
  LOCKDIR="$LOCK_BASE"; echo $$ > "$LOCKDIR/pid"
else
  oldpid="$(cat "$LOCK_BASE/pid" 2>/dev/null)"
  if [ -n "$oldpid" ] && kill -0 "$oldpid" 2>/dev/null; then
    echo "updatetools is already running (PID $oldpid) — refusing to start a second run."
    echo "(Concurrent runs collide on Homebrew's download lock.)"
    exit 1
  fi
  rm -rf "$LOCK_BASE" 2>/dev/null
  if mkdir "$LOCK_BASE" 2>/dev/null; then LOCKDIR="$LOCK_BASE"; echo $$ > "$LOCKDIR/pid"
  else echo "Could not acquire updatetools lock ($LOCK_BASE)."; exit 1; fi
fi


