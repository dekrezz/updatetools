# ===========================================================================
# Smart cask upgrade
# ===========================================================================
# Replaces the old blanket `brew upgrade --cask --no-quit`. For every OUTDATED
# cask it asks classify_cask() what to do, then acts per verdict:
#   skip     — cask ships no .app (font / CLI-only): upgrade in place.
#   upgrade  — app installed but not running: upgrade in place (nobody using it).
#   protect  — app running but unsafe to close (terminal / unsaved / risky /
#              user list): stage with --no-quit; the new version applies on the
#              next launch. Nothing is force-closed, ever.
#   close    — app running and provably safe to quit: quit it gracefully,
#              upgrade, then relaunch. Only reached for scriptable apps with a
#              clean document model, or via the UPDATETOOLS_CLOSE override.
#
# Toggles:  CLOSE_APPS=0 / --no-close   -> treat every `close` as `protect`.
#           BREW_CASK_SKIP="a b"        -> casks needing interactive sudo (kept
#                                          out of the automated run, reported).
#           UPDATETOOLS_CLOSE / UPDATETOOLS_PROTECT — per-token overrides.
ut_upgrade_casks_smart() {
  have brew || { echo "Homebrew not found; skipping casks."; return 0; }
  local greedy_flag="${1:-}"
  local skip_list="${BREW_CASK_SKIP-stats aldente}"
  local close_enabled="${CLOSE_APPS:-1}"
  local skip_re token verdict app bid
  local n_up=0 n_close=0 n_protect=0 n_skip=0
  local manual=()

  skip_re="$(printf '%s' "$skip_list" | tr ', ' '\n\n' | sed '/^$/d' | paste -sd'|' -)"

  while IFS= read -r token; do
    [ -z "$token" ] && continue

    # Casks that need an interactive sudo password (privileged launchctl helper)
    # can't be answered in an automated run — report them for manual upgrade.
    if [ -n "$skip_re" ] && printf '%s\n' "$token" | grep -qxE "$skip_re"; then
      manual+=("$token"); n_skip=$((n_skip+1)); continue
    fi

    verdict="$(classify_cask "$token")"
    [ "$close_enabled" = "1" ] || { [ "$verdict" = "close" ] && verdict="protect"; }

    case "$verdict" in
      close)
        app="$(cask_to_apps "$token" | head -n1)"
        bid="$(app_to_bundleid "$app" 2>/dev/null)"
        echo ">> $token: running & safe to close — quitting, upgrading, relaunching"
        if [ -n "$bid" ] && graceful_quit "$bid" 20; then
          brew upgrade --cask "$token" || true
          relaunch_app "$bid"
          n_close=$((n_close+1))
        else
          echo "   quit did not complete (unsaved work / not scriptable) — staging instead"
          brew upgrade --cask --no-quit "$token" || true
          n_protect=$((n_protect+1))
        fi
        ;;
      protect)
        echo ">> $token: running & protected — staging (new version applies on next launch)"
        brew upgrade --cask --no-quit "$token" || true
        n_protect=$((n_protect+1))
        ;;
      upgrade)
        echo ">> $token: not running — upgrading in place"
        brew upgrade --cask --no-quit "$token" || true
        n_up=$((n_up+1))
        ;;
      *)  # skip = no app artifact (font / CLI-only cask)
        echo ">> $token: no app bundle — upgrading in place"
        brew upgrade --cask --no-quit "$token" || true
        n_up=$((n_up+1))
        ;;
    esac
  done <<< "$(brew outdated --cask $greedy_flag --quiet 2>/dev/null)"

  if [ "${#manual[@]}" -gt 0 ]; then
    echo "Skipped casks needing interactive sudo — upgrade manually when present:"
    local c; for c in "${manual[@]}"; do echo "  brew upgrade --cask $c"; done
  fi
  echo "casks: $n_up upgraded · $n_close closed+relaunched · $n_protect staged · $n_skip skipped(manual)"
  return 0
}

# ===========================================================================
# Quiet updates for manually installed drag-and-drop apps
# ===========================================================================
# These apps are not adopted into Homebrew. Homebrew's cask metadata is used only
# as a signed-download catalogue. Matching and installation fail closed:
#   * exactly one cask must ship an app with the same bundle filename;
#   * the cask must expose a comparable, newer version and a SHA-256 checksum;
#   * the downloaded app must keep the bundle ID and Developer Team ID;
#   * codesign and Gatekeeper must accept the replacement.
# A running app is never quit or modified. Its verified replacement is staged as
# a hidden sibling and a detached helper swaps the bundles after a natural exit.
# Apps without Spotlight evidence they came from a .dmg, and apps that already
# ship their own updater, are left alone.

ut_version_lt() { # $1 installed, $2 candidate; numeric dotted versions only
  local old="${1#v}" new="${2#v}"
  old="${old%%,*}"; new="${new%%,*}"
  printf '%s\n' "$old" | grep -Eq '^[0-9]+([.][0-9]+)*$' || return 1
  printf '%s\n' "$new" | grep -Eq '^[0-9]+([.][0-9]+)*$' || return 1
  awk -v a="$old" -v b="$new" 'BEGIN {
    na=split(a, av, "."); nb=split(b, bv, "."); n=(na>nb?na:nb)
    for (i=1; i<=n; i++) {
      ai=(i<=na?av[i]+0:0); bi=(i<=nb?bv[i]+0:0)
      if (ai < bi) exit 0
      if (ai > bi) exit 1
    }
    exit 1
  }'
}

ut_cask_match_token() { # $1 aggregate cask JSON, $2 exact app bundle basename
  local catalog="$1" app="$2"
  jq -r --arg app "$app" '
    [.[] | select(any(.artifacts[]?; any(.app[]?;
      type == "string" and ((split("/") | last) == $app)))) | .token]
    | if length == 1 then .[0] else empty end
  ' "$catalog" 2>/dev/null
}

ut_cask_build_index() { # $1 aggregate cask JSON, $2 output TSV
  jq -r '
    .[] as $c | $c.artifacts[]? | objects | .app[]?
    | select(type == "string") | [(split("/") | last), $c.token] | @tsv
  ' "$1" > "$2"
}

ut_cask_match_index() { # $1 app-name<TAB>token index, $2 exact app basename
  local index="$1" app="$2"
  awk -F '\t' -v app="$app" '$1 == app { token=$2; count++ }
    END { if (count == 1) print token }' "$index"
}

UT_DMG_ICON_B64=''

ut_plist_value() { # $1 app path, $2 key
  /usr/libexec/PlistBuddy -c "Print :$2" "$1/Contents/Info.plist" 2>/dev/null
}

# True when the text contains a .dmg URL or filename. Fail closed on empty input.
ut_urls_look_like_dmg() {
  printf '%s\n' "${1-}" | grep -qiE '\.dmg([^A-Za-z0-9]|$)'
}

# Only treat an app as a drag-and-drop DMG install when macOS still records a
# .dmg download source. A missing or null kMDItemWhereFroms is a skip.
ut_app_from_dmg() {
  local app="${1-}" raw
  [ -d "$app" ] || return 1
  raw="$(mdls -raw -name kMDItemWhereFroms "$app" 2>/dev/null || true)"
  case "$raw" in ""|"(null)") raw="" ;; esac
  if [ -z "$raw" ]; then
    raw="$(xattr -p com.apple.metadata:kMDItemWhereFroms "$app" 2>/dev/null || true)"
  fi
  ut_urls_look_like_dmg "$raw"
}

# Apps that already update themselves (Sparkle, Mozilla/Tor updater).
ut_app_self_updates() {
  local app="${1-}"
  [ -d "$app" ] || return 1
  [ -f "$app/Contents/Info.plist" ] && {
    local feed
    feed="$(ut_plist_value "$app" SUFeedURL)"
    case "$feed" in https://*|http://*) return 0 ;; esac
  }
  [ -d "$app/Contents/Frameworks/Sparkle.framework" ] && return 0
  [ -d "$app/Contents/MacOS/updater.app" ] && return 0
  [ -x "$app/Contents/MacOS/updater" ] && return 0
  return 1
}

# Quiet download with periodic size lines so the stall watchdog stays alive
# without dumping a curl progress bar into the dashboard log.
ut_curl_file() { # $1 url, $2 dest, $3 label
  local url="$1" dest="$2" label="$3" pid size last=""
  curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' \
    -o "$dest" "$url" &
  pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    size=$(wc -c < "$dest" 2>/dev/null || echo 0)
    size=${size// /}
    if [ -n "$size" ] && [ "$size" != "$last" ]; then
      echo "   $label: $((size / 1048576)) MB"
      last="$size"
    fi
    sleep 2
  done
  wait "$pid"
}

ut_team_id() { # $1 app path
  codesign -dv --verbose=4 "$1" 2>&1 | awk -F= '/^TeamIdentifier=/{print $2; exit}'
}

ut_build_swap_helper() { # $1 output executable
  local out="$1" src
  src="${out}.c"
  mkdir -p "$(dirname "$out")" || return 1
  cat > "$src" <<'UT_SWAP_C'
#include <errno.h>
#include <fcntl.h>
#include <stdio.h>
#include <unistd.h>
#ifndef RENAME_SWAP
#define RENAME_SWAP 0x00000002
#endif
int main(int argc, char **argv) {
  if (argc != 3) return 64;
  if (renameatx_np(AT_FDCWD, argv[1], AT_FDCWD, argv[2], RENAME_SWAP) != 0) {
    perror("renameatx_np");
    return 1;
  }
  return 0;
}
UT_SWAP_C
  xcrun clang -Os -Wall -Wextra -Werror "$src" -o "$out" >/dev/null 2>&1
  local rc=$?
  rm -f "$src"
  [ "$rc" -eq 0 ] && chmod 700 "$out"
  return "$rc"
}

ut_atomic_swap() { # $1 installed app/dir, $2 staged app/dir, $3 optional helper
  local target="$1" staged="$2" helper="${3:-}" own=""
  [ -d "$target" ] && [ -d "$staged" ] || return 1
  [ "$(stat -f '%d' "$target" 2>/dev/null)" = "$(stat -f '%d' "$staged" 2>/dev/null)" ] || return 1
  if [ -z "$helper" ]; then
    own="$(mktemp -d "${TMPDIR:-/tmp}/updatetools-swap.XXXXXX")" || return 1
    helper="$own/swap"
    ut_build_swap_helper "$helper" || { rm -rf "$own"; return 1; }
  fi
  "$helper" "$target" "$staged"
  local rc=$?
  [ -n "$own" ] && rm -rf "$own"
  return "$rc"
}

ut_verify_app_replacement() { # $1 installed, $2 candidate
  local installed="$1" candidate="$2"
  local old_bid new_bid old_team new_team old_ver new_ver
  old_bid="$(ut_plist_value "$installed" CFBundleIdentifier)"
  new_bid="$(ut_plist_value "$candidate" CFBundleIdentifier)"
  [ -n "$old_bid" ] && [ "$old_bid" = "$new_bid" ] || return 1
  old_team="$(ut_team_id "$installed")"; new_team="$(ut_team_id "$candidate")"
  [ -n "$old_team" ] && [ "$old_team" = "$new_team" ] || return 1
  codesign --verify --deep --strict --verbose=2 "$installed" >/dev/null 2>&1 || return 1
  codesign --verify --deep --strict --verbose=2 "$candidate" >/dev/null 2>&1 || return 1
  spctl --assess --type execute --verbose=2 "$candidate" >/dev/null 2>&1 || return 1
  old_ver="$(ut_plist_value "$installed" CFBundleShortVersionString)"
  new_ver="$(ut_plist_value "$candidate" CFBundleShortVersionString)"
  [ -n "$old_ver" ] && [ -n "$new_ver" ] && ut_version_lt "$old_ver" "$new_ver"
}

ut_spawn_deferred_swap() { # $1 target, $2 staged, $3 bundle id
  local target="$1" staged="$2" bid="$3"
  local jobs="$HOME/Library/Caches/updatetools/jobs" safe job helper script
  safe="$(printf '%s' "$bid" | tr -cs 'A-Za-z0-9._-' '_')"
  job="$jobs/${safe}-$(date +%s)-$$"
  helper="$job/swap"; script="$job/install.sh"
  mkdir -p "$job" || return 1
  ut_build_swap_helper "$helper" || { rm -rf "$job"; return 1; }

  {
    printf '#!/bin/bash\nset -u\n'
    printf 'target=%q\nstaged=%q\nbid=%q\nhelper=%q\njob=%q\n' \
      "$target" "$staged" "$bid" "$helper" "$job"
    cat <<'UT_DEFERRED'
log="$job/install.log"
while [ -n "$(/usr/bin/lsappinfo find "bundleID=$bid" 2>/dev/null)" ]; do
  sleep 5
done
sleep 1
if [ -n "$(/usr/bin/lsappinfo find "bundleID=$bid" 2>/dev/null)" ]; then
  exit 0
fi
plist_bid() { /usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$1/Contents/Info.plist" 2>/dev/null; }
team_id() { /usr/bin/codesign -dv --verbose=4 "$1" 2>&1 | /usr/bin/awk -F= '/^TeamIdentifier=/{print $2; exit}'; }
if [ "$(plist_bid "$target")" != "$bid" ] || [ "$(plist_bid "$staged")" != "$bid" ]; then
  printf 'bundle identity changed; staged update retained\n' > "$log"; exit 1
fi
if [ -z "$(team_id "$target")" ] || [ "$(team_id "$target")" != "$(team_id "$staged")" ]; then
  printf 'signing identity changed; staged update retained\n' > "$log"; exit 1
fi
/usr/bin/codesign --verify --deep --strict "$target" >/dev/null 2>&1 || exit 1
/usr/bin/codesign --verify --deep --strict "$staged" >/dev/null 2>&1 || exit 1
/usr/sbin/spctl --assess --type execute "$staged" >/dev/null 2>&1 || exit 1
if "$helper" "$target" "$staged"; then
  /bin/rm -rf "$staged"
  /bin/rm -rf "$job"
fi
UT_DEFERRED
  } > "$script"
  chmod 700 "$script"
  nohup /bin/bash "$script" >/dev/null 2>&1 </dev/null &
  return 0
}

ut_install_or_defer() { # $1 installed app, $2 verified staged app, $3 bundle id
  local target="$1" staged="$2" bid="$3"
  if ! is_running "$bid"; then
    ut_atomic_swap "$target" "$staged" || return 1
    rm -rf "$staged" # after the swap this path contains the old app
    return 0
  fi
  [ "${UPDATETOOLS_DEFER_SPAWN:-1}" = "1" ] || return 3
  ut_spawn_deferred_swap "$target" "$staged" "$bid" || return 1
  return 3
}

ut_update_manual_apps() {
  if ! have brew || ! have jq || ! have curl || ! have xcrun; then
    echo "manual apps: brew, jq, curl, or Xcode command-line tools missing — skipped"
    return 0
  fi
  local work catalog index roots root app name token info cask_ver installed_ver url sha
  local download mount candidate bid stage rc now_ver
  local found=0 managed=0 matched=0 updated=0 deferred=0 skipped=0 current=0
  work="$(mktemp -d "${TMPDIR:-/tmp}/updatetools-apps.XXXXXX")" || return 1
  catalog="$work/casks.json"
  index="$work/apps.tsv"
  if [ -n "${UPDATETOOLS_CASK_CATALOG:-}" ]; then
    cp "$UPDATETOOLS_CASK_CATALOG" "$catalog" || { rm -rf "$work"; return 1; }
  elif ! curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' \
        https://formulae.brew.sh/api/cask.json -o "$catalog"; then
      rm -rf "$work"; echo "manual apps: could not fetch cask catalogue"; return 1
  fi
  ut_cask_build_index "$catalog" "$index" || {
    rm -rf "$work"; echo "manual apps: invalid cask catalogue"; return 1
  }

  roots="${UPDATETOOLS_APP_ROOTS:-/Applications:$HOME/Applications}"
  while IFS= read -r root; do
    [ -d "$root" ] || continue
    while IFS= read -r -d '' app; do
      found=$((found+1)); name="${app##*/}"
      [ -f "$app/Contents/_MASReceipt/receipt" ] && { skipped=$((skipped+1)); continue; }
      bid="$(ut_plist_value "$app" CFBundleIdentifier)"
      [ -n "$bid" ] || { skipped=$((skipped+1)); continue; }
      case "$bid" in com.apple.*) skipped=$((skipped+1)); continue ;; esac

      token="$(ut_cask_match_index "$index" "$name")"
      [ -n "$token" ] || { skipped=$((skipped+1)); continue; }
      if brew list --cask "$token" >/dev/null 2>&1; then
        managed=$((managed+1)); continue
      fi
      info="$(brew info --json=v2 --cask "$token" 2>/dev/null)"
      [ -n "$info" ] || { skipped=$((skipped+1)); continue; }
      cask_ver="$(printf '%s' "$info" | jq -r '.casks[0].version // empty' | cut -d, -f1)"
      installed_ver="$(ut_plist_value "$app" CFBundleShortVersionString)"
      if [ -z "$installed_ver" ] || [ -z "$cask_ver" ] || ! ut_version_lt "$installed_ver" "$cask_ver"; then
        current=$((current+1)); continue
      fi
      if ut_app_self_updates "$app"; then
        echo ">> $name: $installed_ver, updates itself — left alone"
        skipped=$((skipped+1)); continue
      fi
      if ! ut_app_from_dmg "$app"; then
        echo ">> $name: $installed_ver, not installed from a DMG — left alone"
        skipped=$((skipped+1)); continue
      fi
      matched=$((matched+1))
      if [ "${UPDATETOOLS_MANUAL_APPS_DRY_RUN:-0}" = "1" ]; then
        echo ">> $name: $installed_ver → $cask_ver (would stage verified DMG)"
        continue
      fi
      url="$(printf '%s' "$info" | jq -r '.casks[0].url // empty')"
      sha="$(printf '%s' "$info" | jq -r '.casks[0].sha256 // empty')"
      case "$url" in https://*) ;; *) skipped=$((skipped+1)); continue ;; esac
      printf '%s\n' "$sha" | grep -Eq '^[0-9a-fA-F]{64}$' \
        || { skipped=$((skipped+1)); continue; }
      now_ver="$(ut_plist_value "$app" CFBundleShortVersionString)"
      if [ -z "$now_ver" ] || ! ut_version_lt "$now_ver" "$cask_ver"; then
        echo ">> $name: $now_ver already current"
        current=$((current+1)); matched=$((matched-1)); continue
      fi
      echo ">> $name: $now_ver → $cask_ver (verified DMG staging)"

      download="$work/${token}.download"
      if ! ut_curl_file "$url" "$download" "$name"; then
        echo "   download failed — skipped"; skipped=$((skipped+1)); continue
      fi
      now_ver="$(ut_plist_value "$app" CFBundleShortVersionString)"
      if [ -z "$now_ver" ] || ! ut_version_lt "$now_ver" "$cask_ver"; then
        echo "   already current after its own updater — discarded download"
        current=$((current+1)); matched=$((matched-1)); rm -f "$download"; continue
      fi
      [ "$(shasum -a 256 "$download" | awk '{print $1}')" = "$sha" ] || {
        echo "   checksum mismatch — rejected"; skipped=$((skipped+1)); rm -f "$download"; continue
      }
      mount="$work/mount-$token"; mkdir -p "$mount"
      if ! hdiutil attach -readonly -nobrowse -mountpoint "$mount" "$download" >/dev/null 2>&1; then
        echo "   not a mountable DMG — skipped"; skipped=$((skipped+1)); continue
      fi
      candidate="$(find "$mount" -maxdepth 4 -type d -name "$name" -print -quit 2>/dev/null)"
      if [ -z "$candidate" ] || ! ut_verify_app_replacement "$app" "$candidate"; then
        echo "   bundle ID, Team ID, version, codesign, or Gatekeeper check failed — rejected"
        hdiutil detach "$mount" -quiet 2>/dev/null || true
        skipped=$((skipped+1)); continue
      fi
      stage="$(dirname "$app")/.updatetools-stage-${token}-${cask_ver}.app"
      case "$stage" in */.updatetools-stage-*.app) rm -rf "$stage" ;; *) continue ;; esac
      if ! ditto "$candidate" "$stage"; then
        hdiutil detach "$mount" -quiet 2>/dev/null || true
        rm -rf "$stage"; skipped=$((skipped+1)); continue
      fi
      hdiutil detach "$mount" -quiet 2>/dev/null || true
      ut_verify_app_replacement "$app" "$stage" || {
        echo "   staged copy failed re-verification — rejected"
        rm -rf "$stage"; skipped=$((skipped+1)); continue
      }
      ut_install_or_defer "$app" "$stage" "$bid"; rc=$?
      case "$rc" in
        0) echo "   installed atomically"; updated=$((updated+1)) ;;
        3) echo "   app is running; will install after its natural exit"; deferred=$((deferred+1)) ;;
        *) echo "   could not schedule installation; staged copy retained"; skipped=$((skipped+1)) ;;
      esac
      rm -f "$download"
    done < <(find "$root" -maxdepth 1 -type d -name '*.app' -print0 2>/dev/null)
  done <<< "$(printf '%s' "$roots" | tr ':' '\n')"
  rm -rf "$work"
  if [ "$updated" -eq 0 ] && [ "$deferred" -eq 0 ] && [ "$matched" -eq 0 ]; then
    echo "manual apps: already up to date ($found scanned · $current current · $managed Homebrew-managed · $skipped left alone)"
  else
    echo "manual apps: $found scanned · $managed Homebrew-managed · $current current · $matched updates matched · $updated installed · $deferred deferred · $skipped left alone"
  fi
  return 0
}

ut_update_homebrew_all() {
  local rc=0
  brew update || rc=1

  # Keep this invisible in the dashboard: it is report bookkeeping, not a
  # user-facing update step. It must happen after the index refresh and before
  # any package changes.
  ut_report_begin

  HOMEBREW_NO_UPGRADE_AUTO_UPDATES_CASKS=1 brew upgrade || rc=1
  ut_upgrade_casks_smart "$GREEDY_FLAG" || rc=1
  brew autoremove || rc=1
  brew cleanup -s || rc=1
  return "$rc"
}

# ===========================================================================
# Version report -> ~/Desktop/updatetools-report-*.html
# ===========================================================================
# ut_report_begin  captures the "before" state (once, idempotent) AFTER
#   `brew update` and BEFORE any upgrade, into files under UT_REPORT_DIR.
# ut_report_finish captures the "after" state, diffs, writes the HTML report,
#   optionally opens it, and records the path in UT_LASTREPORT.
# $$ is stable across the step subshells a run spawns, so both halves agree
# on these paths even when run from different subshells.
UT_REPORT_DIR="${TMPDIR:-/tmp}/updatetools-report-$$"
UT_LASTREPORT="${TMPDIR:-/tmp}/updatetools-lastreport-$$"

# First dotted-numeric run from a noisy --version line (go1.26.5 -> 1.26.5).
_ut_ver() {
  awk '{
    if (match($0, /[0-9]+(\.[0-9]+)+([._+-][0-9A-Za-z.]+)?/))
      print substr($0, RSTART, RLENGTH);
    else { gsub(/^[ \t]+|[ \t]+$/, ""); print }
  }'
}

# Emit "name<TAB>version" for standalone CLIs (those not tracked via brew casks).
ut_capture_cli_versions() {
  local spec cmd args raw
  for spec in \
    "node|-v" "npm|-v" "pnpm|-v" "yarn|-v" "bun|-v" \
    "deno|--version" "uv|--version" "cargo|--version" "go|version" \
    "gem|--version" "claude|--version" "codex|--version" "agy|--version" \
    "gh|--version" "supabase|--version" "vercel|--version" "mas|version"; do
    cmd="${spec%%|*}"; args="${spec#*|}"
    have "$cmd" || continue
    raw="$("$cmd" $args 2>/dev/null | head -1)"
    [ -n "$raw" ] || continue
    printf '%s\t%s\n' "$cmd" "$(printf '%s' "$raw" | _ut_ver)"
  done
}

# Parse one `brew outdated --verbose` line ("name (old...) OP new") -> record.
_ut_parse_outdated() {  # $1 line, $2 kind
  local l="$1" kind="$2" name old new
  name="${l%% *}"
  # old sits inside "(...)": for a multi-install list "(1.0, 1.1)" keep the first
  # entry, but split only on the ", " list separator so a single "version,build"
  # cask version (e.g. "116.5.5,538461") keeps its build — matching `new`, which
  # keeps the whole last token, so old->new renders symmetrically.
  old="${l#*\(}"; old="${old%%)*}"; old="${old%%, *}"
  new="${l##* }"
  printf '%s|%s|%s|%s\n' "$name" "$old" "$new" "$kind"
}

ut_capture_brew_before() {
  have brew || return 0
  brew outdated --formula --verbose 2>/dev/null | while IFS= read -r l; do
    [ -n "$l" ] && _ut_parse_outdated "$l" formula
  done
  brew outdated --cask --greedy --verbose 2>/dev/null | while IFS= read -r l; do
    [ -n "$l" ] && _ut_parse_outdated "$l" cask
  done
}

ut_report_begin() {
  [ "${MAKE_REPORT:-1}" = "1" ] || return 0
  mkdir -p "$UT_REPORT_DIR" 2>/dev/null || return 0
  [ -f "$UT_REPORT_DIR/.began" ] && return 0   # idempotent: only the first call captures
  : > "$UT_REPORT_DIR/.began"
  ut_capture_brew_before   > "$UT_REPORT_DIR/brew" 2>/dev/null || true
  ut_capture_cli_versions  > "$UT_REPORT_DIR/cli"  2>/dev/null || true
  return 0
}

# Look up display + url for a name, appending "key|display|old|new|url" to a file.
_ut_emit_card() {  # $1 rawname, $2 old, $3 new, $4 out_file
  local nkey dl disp url
  nkey="$(ut_normalize "$1")"
  dl="$(ut_changelog_lookup "$nkey")"
  disp="${dl%%$'\t'*}"; url="${dl#*$'\t'}"
  [ -n "$disp" ] || disp="$1"
  printf '%s|%s|%s|%s|%s\n' "$nkey" "$disp" "$2" "$3" "$url" >> "$4"
}

ut_generate_report() {  # $1 = optional output path
  [ "${MAKE_REPORT:-1}" = "1" ] || return 0
  local out="${1:-}"
  # UT_REPORT_OUT lets a run redirect the report — the browser dashboard points it
  # at its own served directory so nothing is dropped on the Desktop.
  [ -n "$out" ] || out="${UT_REPORT_OUT:-$HOME/Desktop/updatetools-report-$(date '+%Y%m%d-%H%M%S').html}"
  local data data2 after_brew after_cli
  data="$(mktemp)"; data2="$(mktemp)"

  # brew: a formula/cask that was outdated before and is no longer outdated now
  # was successfully upgraded this run.
  if [ -f "$UT_REPORT_DIR/brew" ] && have brew; then
    after_brew="$( { brew outdated --quiet 2>/dev/null; \
                     brew outdated --cask --greedy --quiet 2>/dev/null; } )"
    while IFS='|' read -r name old new kind; do
      [ -n "$name" ] || continue
      printf '%s\n' "$after_brew" | grep -qxF "$name" && continue   # still outdated
      _ut_emit_card "$name" "$old" "$new" "$data"
    done < "$UT_REPORT_DIR/brew"
  fi

  # cli: version string changed between before and after. Appended AFTER brew so
  # that on a key collision (e.g. gh formula vs gh cli) the cli entry wins dedup.
  if [ -f "$UT_REPORT_DIR/cli" ]; then
    after_cli="$(mktemp)"
    ut_capture_cli_versions > "$after_cli" 2>/dev/null || true
    while IFS=$'\t' read -r ckey cold; do
      [ -n "$ckey" ] || continue
      local cnew
      cnew="$(grep -m1 "^$ckey"$'\t' "$after_cli" 2>/dev/null | cut -f2-)"
      [ -n "$cnew" ] && [ "$cnew" != "$cold" ] && _ut_emit_card "$ckey" "$cold" "$cnew" "$data"
    done < "$UT_REPORT_DIR/cli"
    rm -f "$after_cli"
  fi

  # Dedup by key (field 1), keeping the last occurrence (cli beats brew).
  awk -F'|' '{ rows[$1]=$0; seq[$1]=NR } END { for (k in rows) print seq[k]"\t"rows[k] }' \
      "$data" | sort -n | cut -f2- > "$data2"

  # Hand the same records to the live dashboard, so its "after" section shows
  # the identical diff without recomputing it.
  [ -n "${UT_WEB_DATA:-}" ] && cp "$data2" "$UT_WEB_DATA" 2>/dev/null
  generate_html_report "$out" "$data2" >/dev/null
  printf '%s' "$out" > "$UT_LASTREPORT"
  rm -f "$data" "$data2"
  rm -rf "$UT_REPORT_DIR" 2>/dev/null
  printf '%s\n' "$out"
}

# Convenience: generate, then open unless disabled.
ut_report_finish() {
  [ "${MAKE_REPORT:-1}" = "1" ] || return 0
  local path; path="$(ut_generate_report)"
  echo "Report: $path"
  if [ "${OPEN_REPORT:-1}" = "1" ] && [ -n "$path" ] && [ -f "$path" ]; then
    open "$path" 2>/dev/null || true
  fi
  return 0
}

