# ut_icon_homepage KEY — the tool's homepage, straight from Homebrew's metadata.
# Cheap enough to call per tool (~0.3s) and only used for logos we don't ship.
# ut_brew_meta KEY — cache Homebrew's metadata for KEY: its display name and its
# homepage, in one `brew info` call. Casks carry the vendor's own capitalisation
# ("ChatGPT", "GitHub Copilot", "Wispr Flow"); formulae are genuinely lowercase
# (ggml, simdjson, uv), so whatever Homebrew says is what we print.
ut_brew_meta() {
  local k=${1-} cache base json
  [ -z "$k" ] && return 1
  cache="${XDG_CACHE_HOME:-$HOME/.cache}/updatetools/icons"
  base="$cache/${k//[^A-Za-z0-9._-]/_}"
  [ -f "$base.meta" ] && return 0          # already resolved (possibly to nothing)
  have brew && have jq || return 1
  mkdir -p "$cache" 2>/dev/null || return 1

  json=$(brew info --json=v2 --cask "$k" 2>/dev/null)
  if [ -n "$json" ] && [ "$(printf '%s' "$json" | jq -r '.casks | length' 2>/dev/null)" = "1" ]; then
    printf '%s' "$json" | jq -r '.casks[0].name[0] // empty'  > "$base.name"
    printf '%s' "$json" | jq -r '.casks[0].homepage // empty' > "$base.url"
  else
    json=$(brew info --json=v2 --formula "$k" 2>/dev/null)
    printf '%s' "$json" | jq -r '.formulae[0].name // empty'     > "$base.name" 2>/dev/null
    printf '%s' "$json" | jq -r '.formulae[0].homepage // empty' > "$base.url"  2>/dev/null
  fi
  : > "$base.meta"
}

# ut_pretty_name KEY FALLBACK — the vendor's spelling, or FALLBACK.
#
# Homebrew echoes the bare token for many formulae ("vercel"), which would
# overwrite a better label we already had ("Vercel CLI"). So prefer whichever
# of the two carries real capitalisation; fall back to Homebrew otherwise.
ut_pretty_name() {
  local k=${1-} fb=${2-} cache f n=""
  cache="${XDG_CACHE_HOME:-$HOME/.cache}/updatetools/icons"
  f="$cache/${k//[^A-Za-z0-9._-]/_}.name"
  ut_brew_meta "$k" 2>/dev/null
  [ -s "$f" ] && n=$(cat "$f")
  case "$n" in
    *[[:upper:]]*) printf '%s' "$n" ;;
    *) case "$fb" in
         *[[:upper:]]*) printf '%s' "$fb" ;;
         *)       printf '%s' "${n:-$fb}" ;;
       esac ;;
  esac
}

ut_icon_homepage() {
  local k=${1-} cache f
  [ -z "$k" ] && return 1
  cache="${XDG_CACHE_HOME:-$HOME/.cache}/updatetools/icons"
  f="$cache/${k//[^A-Za-z0-9._-]/_}.url"
  ut_brew_meta "$k" 2>/dev/null
  [ -s "$f" ] || return 1
  cat "$f"
}

# ut_icon_datauri HOMEPAGE — a data: URI for the site's icon, cached on disk.
#
# Two sources, in order of how much they look like the project's actual logo:
#   github.com/<org>/…  -> the org's avatar (the real mark, not GitHub's favicon)
#   anything else       -> the site's favicon
# Network failures are not fatal: the caller falls back to a monogram.
ut_icon_datauri() {
  local url=${1-} host org cache key file mime b64
  [ -z "$url" ] && return 1
  host=${url#*://}; host=${host%%/*}
  [ -z "$host" ] && return 1

  cache="${XDG_CACHE_HOME:-$HOME/.cache}/updatetools/icons"
  mkdir -p "$cache" 2>/dev/null || return 1

  case "$host" in
    github.com)
      org=${url#*github.com/}; org=${org%%/*}
      [ -z "$org" ] && return 1
      key="gh-$org"; url="https://github.com/$org.png?size=128" ;;
    *)
      key="$host"; url="https://icons.duckduckgo.com/ip3/$host.ico" ;;
  esac
  file="$cache/${key//[^A-Za-z0-9._-]/_}"

  if [ ! -s "$file" ]; then
    curl -sL --max-time 6 -o "$file" "$url" 2>/dev/null || return 1
    [ -s "$file" ] || { rm -f "$file"; return 1; }
    # Sites happily serve a 512px favicon for a 22px slot — downscale so the
    # report stays light (sips ships with macOS; skip quietly if it fails).
    if [ "$(wc -c < "$file")" -gt 8192 ] && command -v sips >/dev/null 2>&1; then
      sips -s format png -Z 64 "$file" --out "$file.small" >/dev/null 2>&1 \
        && mv -f "$file.small" "$file"
    fi
  fi

  # MIME from the magic bytes — these endpoints return png/jpeg/webp/ico alike.
  case "$(head -c 4 "$file" | od -An -tx1 | tr -d ' \n')" in
    89504e47) mime=image/png ;;
    ffd8ff*)  mime=image/jpeg ;;
    52494646) mime=image/webp ;;
    00000100) mime=image/x-icon ;;
    *) rm -f "$file"; return 1 ;;
  esac
  b64=$(base64 < "$file" | tr -d '\n')
  [ -z "$b64" ] && return 1
  printf 'data:%s;base64,%s' "$mime" "$b64"
}

# ut_icon_site NAME — where to fetch a logo for tools Simple Icons doesn't ship.
