</head>
<body>
  <div class="wrap">
    <header class="masthead">
HTML_CSS
    printf '      <h1>updatetools</h1>\n'
    printf '      <p class="meta"><strong>%s</strong> <span class="sep">\xc2\xb7</span> <time datetime="%s">%s</time></p>\n' \
      "$summary_e" "$date_e" "$date_long_e"
    cat <<'HTML_MID'
    </header>
    <div class="toolbar">
        <label class="search">
          <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="7" cy="7" r="4.5" stroke="currentColor" stroke-width="1.6"/><path d="M10.5 10.5 14 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          <input id="q" type="search" placeholder="Filter tools" autocomplete="off" spellcheck="false" aria-label="Filter tools">
        </label>
        <button class="btn" id="copy" type="button">Copy list</button>
      </div>
HTML_MID
    # Logo sprite: defined once, referenced by every card that needs it.
    [ -n "$sprite" ] && printf '    <svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>\n%s    </defs></svg>\n' "$sprite"
    printf '    <main class="list" id="list">\n'
    printf '%s' "$cards"
    cat <<'HTML_TAIL'
    </main>
    <p class="nores" id="nores" hidden>Nothing matches that filter.</p>
  </div>
<script>
(() => {
  'use strict';
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ── a critically-damped spring: starts from the current value, carries
        velocity through a re-target, so it can be grabbed and reversed ─────── */
  function spring(get, set, target, opts = {}) {
    const response = opts.response ?? 0.4, damping = opts.damping ?? 1;
    const w = (2 * Math.PI) / response, z = damping;
    let x = get() - target, v = opts.velocity ?? 0, last = performance.now(), raf = 0;
    if (reduce) { set(target); opts.done?.(); return { stop(){}, velocity: () => 0 }; }
    const tick = (now) => {
      const dt = Math.min((now - last) / 1000, 1 / 30); last = now;
      const a = -w * w * x - 2 * z * w * v;
      v += a * dt; x += v * dt;
      if (Math.abs(x) < 0.4 && Math.abs(v) < 0.4) { set(target); opts.done?.(); return; }
      set(target + x); raf = requestAnimationFrame(tick);
    };
    raf = requestAnimationFrame(tick);
    return { stop: () => cancelAnimationFrame(raf), velocity: () => v };
  }

  const cards = [...document.querySelectorAll('.card')];

  /* ── expand: height springs from its live value, so a second click during
        the motion reverses from exactly where it is ───────────────────────── */
  const anims = new WeakMap();
  function toggle(card) {
    const btn = card.querySelector('.row');
    const box = card.querySelector('.detail');
    const inner = card.querySelector('.detail-inner');
    const open = !card.classList.contains('is-open');

    anims.get(box)?.stop();
    const from = box.hidden ? 0 : box.getBoundingClientRect().height;
    box.hidden = false;
    box.style.height = from + 'px';

    card.classList.toggle('is-open', open);
    btn.setAttribute('aria-expanded', String(open));

    const to = open ? inner.getBoundingClientRect().height : 0;
    anims.set(box, spring(
      () => parseFloat(box.style.height) || 0,
      (v) => { box.style.height = v + 'px'; },
      to,
      { response: 0.34, done() { box.style.height = open ? 'auto' : ''; if (!open) box.hidden = true; } }
    ));
  }
  cards.forEach((card) => card.querySelector('.row').addEventListener('click', () => toggle(card)));

  /* ── filtering: no debounce — the list reacts on the keystroke ──────────── */
  const q = document.getElementById('q');
  const nores = document.getElementById('nores');
  function apply() {
    const needle = q.value.trim().toLowerCase();
    let shown = 0;
    cards.forEach((c) => {
      const hit = !needle || c.dataset.name.toLowerCase().includes(needle);
      c.hidden = !hit; if (hit) shown++;
    });
    nores.hidden = shown > 0;
  }
  q.addEventListener('input', apply);
  addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement !== q) { e.preventDefault(); q.focus(); q.select(); }
    if (e.key === 'Escape' && document.activeElement === q) { q.value = ''; apply(); q.blur(); }
  });

  /* ── copy the run as Markdown ───────────────────────────────────────────── */
  const copy = document.getElementById('copy');
  copy.addEventListener('click', async () => {
    const md = cards.filter((c) => !c.hidden)
      .map((c) => `- ${c.dataset.name}: ${c.dataset.old} → ${c.dataset.new}`).join('\n');
    try {
      await navigator.clipboard.writeText(md);
      const was = copy.textContent;
      copy.textContent = 'Copied'; copy.classList.add('ok');
      setTimeout(() => { copy.textContent = was; copy.classList.remove('ok'); }, 1400);
    } catch { copy.textContent = 'Press ⌘C'; }
  });

  /* ── scroll edge effect: hairline only where content passes under chrome ── */
  const toolbar = document.querySelector('.toolbar');
  const onScroll = () => toolbar.classList.toggle('is-stuck', toolbar.getBoundingClientRect().top <= 0);
  addEventListener('scroll', onScroll, { passive: true }); onScroll();

  /* ── entrance: each card springs up, staggered, from its own position ───── */
  cards.forEach((c, i) => {
    c.classList.add('enter');
    setTimeout(() => {
      c.style.opacity = ''; c.style.transform = '';
      if (reduce) { c.classList.remove('enter'); c.style.opacity = '1'; return; }
      let y = 12;
      spring(() => y, (v) => {
        y = v;
        c.style.transform = `translateY(${v}px)`;
        c.style.opacity = String(Math.max(0, Math.min(1, 1 - v / 12)));
      }, 0, { response: 0.5, done() { c.classList.remove('enter'); c.style.transform = ''; c.style.opacity = ''; } });
    }, reduce ? 0 : i * 28);
  });
})();
