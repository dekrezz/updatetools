# ===========================================================================
# HTML report document generator (researched, self-contained, escaped)
# ===========================================================================
# generate_html_report OUT_PATH DATA_FILE
#
# DATA_FILE: one "key|display|old|new|changelog_url" record per updated tool.
#   - Fields are pipe-separated; the changelog_url (5th field) may itself
#     contain '|' (the remainder of the line is taken as the URL).
#   - An empty 5th field (or a trailing '|' with nothing after) means
#     "no known changelog URL" and renders a card with no link.
# Every dynamic value is HTML-escaped (& < > " ').
# Robust under `set -u`; zero updated tools renders an empty-state card.
generate_html_report() {
  local out_path=${1:?generate_html_report: OUT_PATH required}
  local data_file=${2:?generate_html_report: DATA_FILE required}

  if [ ! -f "$data_file" ]; then
    printf 'generate_html_report: data file not found: %s\n' "$data_file" >&2
    return 1
  fi

  # --- HTML-escape a single string (order matters: & first) ---
  html_escape() {
    local s=${1-}
    s=${s//&/&amp;}
    s=${s//</&lt;}
    s=${s//>/&gt;}
    s=${s//\"/&quot;}
    s=${s//\'/&#39;}
    printf '%s' "$s"
  }

  local today
  today=$(date '+%Y-%m-%d')

  local cards="" count=0 used_slugs=""
  local key display old new url
  local d_e o_e n_e u_e link_html

  # `|| [ -n "$key" ]` catches a final line without a trailing newline.
  while IFS='|' read -r key display old new url || [ -n "${key:-}" ]; do
    # Skip fully blank lines.
    if [ -z "${key:-}" ] && [ -z "${display:-}" ] && [ -z "${old:-}" ] \
       && [ -z "${new:-}" ] && [ -z "${url:-}" ]; then
      continue
    fi

    # Ensure every field is defined under `set -u`.
    display=${display:-}
    old=${old:-}
    new=${new:-}
    url=${url:-}

    # Print the tool the way its vendor writes it — "ChatGPT", not "chatgpt".
    display=$(ut_pretty_name "$key" "$display")
    d_e=$(html_escape "$display")
    o_e=$(html_escape "$old")
    n_e=$(html_escape "$new")

    # Trim surrounding whitespace from the URL before the empty check.
    url=${url#"${url%%[![:space:]]*}"}
    url=${url%"${url##*[![:space:]]}"}

    if [ -n "$url" ]; then
      u_e=$(html_escape "$url")
      link_html="        <a class=\"changelog\" href=\"$u_e\" target=\"_blank\" rel=\"noopener noreferrer\">Changelog<span class=\"ext\" aria-hidden=\"true\">&#8599;</span></a>"
    else
      link_html="        <span class=\"no-changelog\">no changelog published</span>"
    fi

    # The summary line shows the human part of a version; build metadata (the
    # ",<git-sha>" some tools append) is detail — it lives one level deeper.
    local o_short n_short os_e ns_e
    o_short=${old%%,*}; n_short=${new%%,*}
    os_e=$(html_escape "$o_short")
    ns_e=$(html_escape "$n_short")

    # Brand logo when we know the tool, a monogram otherwise. Logos are emitted
    # once as <symbol>s and referenced here, so repeats cost nothing.
    local slug logo
    slug="$(ut_icon_slug "$display")"
    if [ -n "$slug" ]; then
      case " $used_slugs " in *" $slug "*) : ;; *) used_slugs="$used_slugs $slug" ;; esac
      logo="<span class=\"logo\" data-slug=\"$slug\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-$slug\"/></svg></span>"
    else
      # Not in the bundled set — fetch the project's own icon (cached), and only
      # fall back to a monogram if that fails too (offline, no homepage, …).
      local uri="" home
      home=$(ut_icon_homepage "$key")
      [ -z "$home" ] && home=$(ut_icon_site "$display")
      [ -n "$home" ] && uri=$(ut_icon_datauri "$home")
      if [ -n "$uri" ]; then
        logo="<span class=\"logo\"><img src=\"$uri\" alt=\"\" loading=\"lazy\" decoding=\"async\"></span>"
      else
        local initial
        initial=$(printf '%s' "$display" | cut -c1 | tr '[:lower:]' '[:upper:]')
        logo="<span class=\"logo mono\" aria-hidden=\"true\">$(html_escape "$initial")</span>"
      fi
    fi

    cards+="    <article class=\"card\" data-name=\"$d_e\" data-old=\"$os_e\" data-new=\"$ns_e\">
      <button class=\"row\" type=\"button\" aria-expanded=\"false\">
        $logo
        <span class=\"name\">$d_e</span>
        <span class=\"ver\"><span class=\"old\">$os_e</span><span class=\"arrow\" aria-hidden=\"true\">&#8594;</span><span class=\"new\">$ns_e</span></span>
        <span class=\"chev\" aria-hidden=\"true\"></span>
      </button>
      <div class=\"detail\" hidden>
        <div class=\"detail-inner\">
          <dl class=\"kv\">
            <dt>from</dt><dd><code>$o_e</code></dd>
            <dt>to</dt><dd><code>$n_e</code></dd>
          </dl>
$link_html
        </div>
      </div>
    </article>
"
    count=$((count + 1))
  done < "$data_file"

  local summary count_label
  if [ "$count" -eq 0 ]; then
    summary="No tools updated"; count_label="nothing to update"
    cards="    <div class=\"empty\">Everything is already up to date.</div>"
  elif [ "$count" -eq 1 ]; then
    summary="1 tool updated"; count_label="tool updated"
  else
    summary="$count tools updated"; count_label="tools updated"
  fi

  local date_e summary_e date_long date_long_e count_label_e
  date_e=$(html_escape "$today")
  summary_e=$(html_escape "$summary")
  # A written-out date reads as a date; the ISO form stays in the datetime attr.
  date_long=$(date '+%A, %e %B %Y' | tr -s ' ')
  date_long_e=$(html_escape "$date_long")
  count_label_e=$(html_escape "$count_label")

  # Build the <symbol> sprite for exactly the logos this report references.
  local sprite="" db slug_line hex path s
  if [ -n "$used_slugs" ]; then
    db="$(ut_icon_db)"
    for s in $used_slugs; do
      slug_line=$(printf '%s\n' "$db" | grep -m1 "^$s ") || continue
      hex=${slug_line#* }; hex=${hex%% *}
      path=${slug_line#* }; path=${path#* }
      sprite+="  <symbol id=\"i-$s\" viewBox=\"0 0 24 24\"><path fill=\"#$hex\" d=\"$path\"/></symbol>
"
    done
  fi

  # --- Emit the document. Placeholders: {{DATE}} {{SUMMARY}} {{CARDS}} ---
  # Quoted heredoc keeps the CSS literal; dynamic values are injected via printf.
  {
    cat <<'HTML_HEAD'
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
HTML_HEAD
    printf '<title>updatetools \xc2\xb7 %s</title>\n' "$date_e"
    cat <<'HTML_CSS'
<style>
  /* Type and spacing scale with the reader's text size: everything is rem, so a
     larger system font enlarges the layout instead of breaking it. */
  :root{
    color-scheme: light;
    --accent:#5C8CFF;
    --ok:#16803c;
    --sans:-apple-system,BlinkMacSystemFont,"SF Pro Text",system-ui,"Segoe UI",Roboto,sans-serif;
    --mono:ui-monospace,SFMono-Regular,"SF Mono",Menlo,Consolas,monospace;
    --r:14px;
    --bg:#ffffff; --bg-tint:#ffffff;
    --surface:#ffffff; --surface-2:#ffffff;
    --hairline:rgba(9,12,25,.09); --hairline-strong:rgba(9,12,25,.18);
    --text:#12151C; --text-2:#5A6076; --text-3:#878DA0;
    --chrome:rgba(255,255,255,.9);
    --shadow:0 1px 2px rgba(16,20,40,.06), 0 10px 30px -14px rgba(16,20,40,.25);
  }
  *{box-sizing:border-box}
  html{-webkit-text-size-adjust:100%}
  body{
    margin:0; background:var(--bg); color:var(--text);
    font:1rem/1.5 var(--sans); -webkit-font-smoothing:antialiased;
    transition:background-color .4s ease, color .4s ease;
  }
  .wrap{max-width:52rem; margin:0 auto; padding:0 1.5rem 6rem}

  /* ── masthead: two levels only — the name, then one line of context.
        Three stacked small blocks (eyebrow / date / count) read as clutter;
        the count is the fact worth stating, the date is its qualifier. ────── */
  .masthead{padding:4.5rem 0 2rem}
  h1{
    margin:0; font-size:clamp(2.25rem,1.5rem + 2.8vw,3.25rem); line-height:1;
    letter-spacing:-.03em; font-weight:700;          /* large type wants negative tracking */
    color:var(--text);
  }
  .meta{
    margin:1.125rem 0 0; font-size:1rem; color:var(--text-2);
    display:flex; align-items:baseline; gap:.5rem; flex-wrap:wrap;
  }
  .meta strong{color:var(--text); font-weight:600; font-variant-numeric:tabular-nums}
  .meta .sep{color:var(--text-3)}

  /* ── toolbar: sticks under the masthead once you scroll past it ─────────── */
  .toolbar{
    position:sticky; top:0; z-index:10; margin:2rem -1.5rem 0; padding:.875rem 1.5rem;
    display:flex; gap:.625rem;
    background:var(--chrome); backdrop-filter:blur(20px) saturate(180%);
    -webkit-backdrop-filter:blur(20px) saturate(180%);
