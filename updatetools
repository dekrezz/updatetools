# ===========================================================================
# Live dashboard (browser)
# ===========================================================================
# The run has no terminal UI: it serves a page on 127.0.0.1, opens it in the
# default browser, and writes state.json after every state change. The page
# polls that file and shows the whole run — the plan before it starts, progress
# while it runs, and the version diff once it's done.
#
# Why a file + poll rather than a socket: the run is a shell script whose steps
# are separate processes; a plain JSON snapshot written atomically is the one
# thing every part of it can update without holding a connection.

WEB_DIR=""; WEB_PID=""; WEB_URL=""; WEB_OPENED=0

# ut_json_escape STRING — escape for a JSON string literal (control chars too).
ut_json_escape() {
  local s=${1-}
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\t'/\\t}
  s=${s//$'\r'/}
  s=${s//$'\n'/\\n}
  # strip anything else below 0x20 that survived
  printf '%s' "$s" | LC_ALL=C tr -d '\000-\010\013\014\016-\037'
}

