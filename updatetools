    text-decoration-color:color-mix(in oklab, var(--text-3) 65%, transparent);
  }
  .ver .to{color:var(--text-2)}
  .ver .to em{font-style:normal; color:var(--text); font-weight:650}
  .ver .move{
    width:.85rem; height:.85rem; flex:none; color:var(--text-3); display:block;
  }
  .ver .move svg{width:100%; height:100%; display:block}
  /* Files: a path is something you copy or open, so give it affordances rather
     than printing it as loose grey text. */
  .files{margin-top:1.75rem; display:flex; flex-direction:column; gap:.5rem}
  .file{
    display:grid; grid-template-columns:auto minmax(0,1fr) auto; align-items:center;
    gap:.875rem; padding:.75rem .875rem; border:1px solid var(--hairline);
    border-radius:12px; background:var(--surface);
  }
  .file .k{font-size:.9375rem; color:var(--text-2); font-weight:550}
  .file .p{
    font-family:var(--mono); font-size:.8125rem; color:var(--text-2);
    overflow:hidden; text-overflow:ellipsis; white-space:nowrap; direction:rtl; text-align:left;
  }
  .file .act{display:flex; gap:.375rem}
  .btn{
    border:1px solid var(--hairline); border-radius:9px; background:none;
    color:var(--text-2); font:inherit; font-size:.8125rem; padding:.3125rem .625rem;
    cursor:pointer; transition:border-color .15s ease, color .15s ease, transform .1s ease-out;
  }
  .btn:hover{border-color:var(--hairline-strong); color:var(--text)}
  .btn:active{transform:scale(.97)}          /* feedback on press, not release */
  .btn.done{color:var(--ok); border-color:color-mix(in oklab,var(--ok) 45%,transparent)}

  /* The log itself, in this window — no switching to a terminal to read it. */
  .logbox{overflow:hidden; margin-top:.5rem}
  .logbox pre{
    margin:0; padding:.875rem 1rem; border:1px solid var(--hairline); border-radius:12px;
    background:var(--bg-tint); color:var(--text-2);
    font-family:var(--mono); font-size:.75rem; line-height:1.55;
    max-height:24rem; overflow:auto; white-space:pre-wrap; overflow-wrap:anywhere;
  }


  /* ── password sheet ────────────────────────────────────────────────────── */
  /* Blur lives on the card, not the scrim — otherwise the sheet's backdrop is
     already a flat fog and the card reads as solid --bg-tint. */
  .scrim{
    position:fixed; inset:0; z-index:50; display:grid; place-items:center; padding:1.5rem;
    background:color-mix(in oklab,var(--bg) 28%,transparent);
    backdrop-filter:blur(18px) saturate(140%);
    -webkit-backdrop-filter:blur(18px) saturate(140%);
    opacity:0; pointer-events:none; transition:opacity .25s ease;
  }
  .scrim.on{opacity:1; pointer-events:auto}
  .sheet{
    width:min(24rem,100%); padding:1.6rem 1.55rem 1.35rem; border-radius:22px;
    font-family:var(--display); font-size:.9375rem; line-height:1.45;
    background:var(--sheet);
    border:1px solid var(--hairline-strong);
    box-shadow:var(--shadow);
    backdrop-filter:blur(28px) saturate(180%);
    -webkit-backdrop-filter:blur(28px) saturate(180%);
    transform:scale(.97); transition:transform .28s cubic-bezier(.2,.8,.2,1);
    position:relative;
    display:flex; flex-direction:column; align-items:stretch; gap:1.15rem;
  }
  .scrim.on .sheet{transform:scale(1)}
  .sheet-head{
    margin:0; display:flex; align-items:center; gap:.4rem;
    width:100%; min-height:1.55rem; flex:none;
  }
  .sheet-head #pw-title{
    display:block; margin:0;
    font-size:1.35rem; font-weight:500; letter-spacing:-.02em; line-height:1.15;
  }
  .info{
    appearance:none; width:1.35rem; height:1.35rem; padding:0;
    border:0; background:transparent; color:var(--text-3);
    display:grid; place-items:center; cursor:default; flex:none;
  }
  .info svg{width:1.1rem; height:1.1rem; display:block}
  .info:hover,.info:focus-visible{color:var(--text-2)}
  .info-tip{
    position:absolute; left:1.2rem; right:1.2rem; top:calc(100% + .55rem); width:auto;
    margin:0; padding:.75rem .85rem; border-radius:12px; text-align:left;
    background:var(--sheet); color:var(--text);
    border:1px solid var(--hairline-strong);
    backdrop-filter:blur(20px) saturate(160%);
    -webkit-backdrop-filter:blur(20px) saturate(160%);
    font-size:.8125rem; font-weight:500; line-height:1.45; letter-spacing:0;
    opacity:0; pointer-events:none; transform:translateY(-4px);
    transition:opacity .18s ease, transform .18s ease; z-index:3;
    box-shadow:0 12px 28px -16px rgba(16,20,40,.28);
  }
  .sheet:has(.info:hover) .info-tip,
  .sheet:has(.info:focus-visible) .info-tip,
  .sheet:has(.info.open) .info-tip{opacity:1; transform:none}
  /* Hidden: centered bullets. Revealed: the actual characters. */
  .pw-decoy{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%);white-space:nowrap}
  form.pw-row{margin:0;padding:0;border:0;background:none}
  .pw-row{display:flex; align-items:center; gap:.65rem; width:100%; flex:none}
  .pw-field{position:relative; flex:1; min-width:0}
  .pw{
    display:block; width:100%; height:2.9rem; padding:0 2.6rem 0 1rem; border-radius:14px;
    font:inherit; border:1px solid var(--hairline-strong);
    background:var(--field);
    color:var(--text); text-shadow:none; caret-color:var(--text);
    -webkit-text-security:none; line-height:2.9rem; letter-spacing:.04em;
    box-sizing:border-box; overflow-x:auto; overflow-y:hidden; white-space:nowrap;
    scrollbar-width:none;
  }
  .pw::-webkit-scrollbar{display:none}
  .sheet.reveal .pw{letter-spacing:0}
  .pw::selection{background:transparent}
  .sheet.reveal .pw::selection{background:color-mix(in oklab,var(--accent) 35%,transparent)}
  .pw:focus{outline:none; border-color:var(--text-3); background:var(--field)}
  .eye{
    appearance:none; position:absolute; right:.45rem; top:50%; transform:translateY(-50%);
    width:1.85rem; height:1.85rem; padding:0; border:0; border-radius:8px;
    background:transparent; color:var(--text-3); display:grid; place-items:center;
    cursor:pointer;
  }
  .eye:hover{color:var(--text)}
  .eye svg{width:1.05rem; height:1.05rem; display:block; grid-area:1 / 1; transition:opacity .2s ease}
  .eye .off{opacity:0}
  .sheet.reveal .eye .on{opacity:0}
  .sheet.reveal .eye .off{opacity:1}
  .go{
    width:2.75rem; height:2.75rem; padding:0; border-radius:50%; border:1px solid transparent;
    background:var(--go-bg); color:var(--go-fg); display:grid; place-items:center;
    flex:none; cursor:pointer; transition:transform .1s ease-out, opacity .15s ease;
  }
  .go svg{width:1.15rem; height:1.15rem; display:block}
  .go:active{transform:scale(.97)}
  .go[disabled]{opacity:.4; cursor:default}

  .theme-switch{
    position:fixed; top:.85rem; right:.85rem; z-index:45;
    display:flex; gap:.1rem; padding:.2rem;
    background:var(--bg-tint); border:1px solid var(--hairline-strong); border-radius:999px;
    box-shadow:var(--shadow);
  }
  .theme-switch button{
    appearance:none; width:2rem; height:2rem; padding:0; border:0; border-radius:999px;
    background:transparent; color:var(--text-3); cursor:pointer;
    display:grid; place-items:center;
  }
  .theme-switch button svg{width:1rem; height:1rem; display:block}
  .theme-switch button[aria-checked="true"]{background:var(--text); color:var(--bg)}
  .theme-switch button:focus-visible{outline:2px solid var(--text); outline-offset:2px}

  @media (prefers-reduced-motion: reduce){
    .step.run .step-state svg{animation:none}
    .wrap,.step,.step.done .step-state svg{animation:none;opacity:1;transform:none}
    .info-tip,.note,.report-panel,.ledger.show,.ledger.hide,.record svg{transition:none;animation:none;filter:none;transform:none}
    .ledger.show,.ledger.hide{clip-path:none}
  }
  @media (prefers-reduced-transparency: reduce){
    .card,.pill,.step.run{background:var(--bg-tint); backdrop-filter:none; -webkit-backdrop-filter:none}
    .scrim{background:color-mix(in oklab,var(--bg) 88%,transparent); backdrop-filter:none; -webkit-backdrop-filter:none}
    .sheet{background:var(--bg-tint); backdrop-filter:none; -webkit-backdrop-filter:none}
  }
  @media (prefers-contrast: more){
    :root{--hairline:currentColor; --hairline-strong:currentColor}
    .card,.pill,.step.run{background:var(--bg-tint)}
  }
  @media (max-width:40rem){
    .wrap{padding:4.25rem 1rem 4rem}
    .masthead{padding:0 0 1.25rem}
    .step{padding:.72rem .65rem}
    .stats{gap:.85rem}
    .theme-switch{top:.6rem; right:.6rem}
  }
</style>
</head>
<body>
  <div class="theme-switch" role="radiogroup" aria-label="Theme">
    <button type="button" role="radio" data-theme="dark" aria-label="Dark" title="Dark">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9"/><path d="M19 3v4M21 5h-4"/></svg>
    </button>
    <button type="button" role="radio" data-theme="light" aria-label="Light" title="Light">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="3.25"/><path d="M12 3.5v1.75M12 18.75V20.5M4.8 4.8l1.25 1.25M17.95 17.95l1.25 1.25M3.5 12h1.75M18.75 12h1.75M4.8 19.2l1.25-1.25M17.95 6.05l1.25-1.25"/></svg>
    </button>
    <button type="button" role="radio" data-theme="system" aria-label="System" title="System">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg>
    </button>
  </div>
  <div class="wrap">
    <header class="masthead">
      <h1>updatetools</h1>
      <p class="meta">
        <strong id="phase">starting…</strong>
        <span class="sep">·</span>
        <span class="clock" id="clock">00:00</span>
      </p>
      <div class="progress">
        <div class="track"><div class="fill" id="fill"></div></div>
        <div class="stats">
          <div class="stat ok" id="s-done">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8.25 12.25 2.5 2.5 5-5.5"/></svg>
            <span class="v" id="c-done">0</span><span class="k">done</span>
          </div>
          <div class="stat skip" id="s-skip">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8.5 12h7"/></svg>
            <span class="v" id="c-skip">0</span><span class="k">skipped</span>
          </div>
          <div class="stat bad" id="s-fail">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m9.25 9.25 5.5 5.5M14.75 9.25l-5.5 5.5"/></svg>
            <span class="v" id="c-fail">0</span><span class="k">failed</span>
          </div>
        </div>
      </div>
    </header>

    <section class="steps" id="steps"></section>

    <section class="result" id="result">
      <div class="rule"></div>
      <div class="verdict" id="verdict">
        <span class="mark" id="r-mark"></span>
        <h2 class="headline" id="r-head">All done</h2>
      </div>
      <button type="button" class="record" id="open-ledger">Open the record</button>
    </section>

    <section class="files" id="files"></section>
    <div class="logbox" id="logbox" hidden><pre id="logtext"></pre></div>
  </div>
  <section class="ledger" id="ledger" hidden>
    <div class="ledger-top">
      <button type="button" class="ledger-back" id="ledger-back">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="m11 18-6-6 6-6"/></svg>
        Back to the run
      </button>
      <div class="ledger-facts" id="ledger-facts"></div>
    </div>
    <h2 class="ledger-title" id="ledger-title">The record</h2>
    <ol class="ledger-list" id="ledger-list"></ol>
    <p class="ledger-empty" id="ledger-empty" hidden>Nothing moved in this run.</p>
  </section>
  <div class="scrim" id="scrim">
    <div class="sheet" id="pwform" role="dialog" aria-modal="true" aria-labelledby="pw-title">
      <div class="sheet-head">
        <span id="pw-title">sudo</span>
        <button type="button" class="info" aria-label="About sudo" aria-describedby="pw-tip">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v6"/><path d="M12 8h.01"/></svg>
        </button>
      </div>
      <p class="info-tip" id="pw-tip" role="tooltip">The password stays on this Mac — never stored, never sent to the cloud. It is only used so we can update programs. What you are working on will not disappear, be deleted, or stop.</p>
      <form class="pw-decoy" autocomplete="username" aria-hidden="true">
        <input type="text" name="username" autocomplete="username" tabindex="-1">
        <input type="password" name="password" autocomplete="current-password" tabindex="-1">
      </form>
      <form class="pw-row" id="ut-chal-form" autocomplete="off" action="javascript:void(0)">
        <div class="pw-field">
          <div class="pw" id="ut-chal" role="textbox" aria-multiline="false" inputmode="none" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" data-lpignore="true" data-1p-ignore="true" data-bwignore="true" data-form-type="other" data-protonpass-ignore="true" aria-label="sudo" contenteditable="false"></div>
          <button class="eye" type="button" id="ut-chal-eye" aria-label="Show password" aria-pressed="false">
            <svg class="on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
            <svg class="off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3l18 18"/><path d="M10.6 10.6a2 2 0 1 0 2.8 2.8"/><path d="M9.5 5.2A11 11 0 0 1 12 5c6.4 0 10 7 10 7a19 19 0 0 1-2.2 3.2"/><path d="M6.7 6.7C4 8.6 2 12 2 12s3.6 7 10 7a10 10 0 0 0 4.2-.9"/></svg>
          </button>
        </div>
        <button class="go" type="button" id="ut-chal-go" aria-label="Continue">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
        </button>
      </form>
    </div>
  </div>
WEB_HTML_HEAD

  # Logo sprite: every bundled mark, so a step can show its tool instantly.
  printf '  <svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>\n'
  ut_icon_db | while IFS=' ' read -r s hex path; do
    [ -n "$s" ] || continue
    printf '    <symbol id="i-%s" viewBox="0 0 24 24"><path fill="#%s" d="%s"/></symbol>\n' "$s" "$hex" "$path"
  done
  printf '  </defs></svg>\n'
  printf '  <script>window.UT_DMG_ICON="data:image/png;base64,%s";</script>\n' "$UT_DMG_ICON_B64"

  cat <<'WEB_HTML_TAIL'
<script>
(() => {
  'use strict';
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const $ = (id) => document.getElementById(id);

  const themeButtons = document.querySelectorAll('.theme-switch button');
  function paintTheme(theme) {
    themeButtons.forEach((b) => {
      b.setAttribute('aria-checked', b.dataset.theme === theme ? 'true' : 'false');
    });
  }
  paintTheme(document.documentElement.dataset.theme || 'light');
  themeButtons.forEach((b) => {
    b.addEventListener('click', () => {
      const theme = b.dataset.theme;
      document.documentElement.dataset.theme = theme;
      try { localStorage.setItem('updatetools-theme', theme); } catch { /* storage blocked */ }
      paintTheme(theme);
    });
  });

  /* critically-damped spring, started from the live value — same behaviour the
     terminal bar had, minus the character grid */
  function spring(get, set, target, response = 0.5) {
    if (reduce) { set(target); return; }
    const w = (2 * Math.PI) / response;
    let x = get() - target, v = 0, last = performance.now();
    const tick = (now) => {
      const dt = Math.min((now - last) / 1000, 1 / 30); last = now;
      v += (-w * w * x - 2 * w * v) * dt; x += v * dt;
      if (Math.abs(x) < 0.001 && Math.abs(v) < 0.001) { set(target); return; }
      set(target + x); requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }

  const fmt = (s) => `${String(Math.floor(s / 60)).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`;
  const dur = (s) => (s == null ? '' : s < 60 ? `${s}s` : fmt(s));

  function logo(slug, img, name) {
    if (img) return `<span class="logo"><img src="${img}" alt=""></span>`;
    if (slug === 'report') return `<span class="logo report-logo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.5 3.5h7l4 4v13h-11z"/><path d="M13.5 3.5v4h4M9 12h6M9 15.5h4"/></svg></span>`;
    if (slug === 'applications' && window.UT_DMG_ICON) return `<span class="logo app-logo"><img src="${window.UT_DMG_ICON}" alt=""></span>`;
    if (slug) return `<span class="logo"><svg viewBox="0 0 24 24"><use href="#i-${slug}"/></svg></span>`;
    return `<span class="logo mono">${(name || '?').charAt(0).toUpperCase()}</span>`;
  }
  function prettyTail(raw) {
    let t = String(raw || '').replace(/\r/g, '').trim();
    if (!t) return '';
    if (/^#{3,}/.test(t)) return '';
    if (/^[#O=\-\s.%]{4,}$/.test(t)) return '';
    return t.replace(/^>>\s+/, '');
  }
  function setStepTail(el, raw) {
    const next = prettyTail(raw);
    let tail = el.querySelector('.tail');
    if (!tail) {
      tail = document.createElement('span');
      tail.className = 'tail';
      el.appendChild(tail);
    }
    if ((tail.dataset.shown || '') === next) return;
    if (!next) return;
    tail.dataset.shown = next;
    const n = String((Number(tail.dataset.n) || 0) + 1);
    tail.dataset.n = n;
    tail.classList.add('fade');
    setTimeout(() => {
      if (tail.dataset.n !== n) return;
      tail.textContent = next;
      tail.classList.remove('fade');
    }, 180);
  }
  function stepState(s, elapsed) {
    if (s.s === 'done') return `<span class="step-state"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4 4 10-10"/></svg>${dur(s.t)}</span>`;
    if (s.s === 'fail') return `<span class="step-state"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m7 7 10 10M17 7 7 17"/></svg>${dur(s.t)}</span>`;
    if (s.s === 'skip') return `<span class="step-state"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M7 12h10"/></svg>${dur(s.t)}</span>`;
    if (s.s === 'run') return `<span class="step-state"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.34-5.66"/></svg><span class="took">${fmt(elapsed)}</span></span>`;
    return `<span class="step-state"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="12" r="8"/></svg></span>`;
  }

  function stepMarkup(s, st) {
    return `<div class="step ${s.s}" data-label="${s.a ? `${s.n} · ${s.a}` : s.n}" role="button" tabindex="0">
          ${logo(s.slug, s.img, s.n)}
          <span class="label"><span class="n">${s.n}</span>${s.a ? `<span class="a">${s.a}</span>` : ''}</span>
          ${stepState(s, st.elapsed - (s.b ?? st.elapsed))}
          ${s.s === 'run' ? `<span class="tail"></span>` : ''}
        </div>`;
  }

  let barPct = 0, lastSig = '', stepsReadyTimer = 0;
  let latestUpdates = [], latestPhase = 'run';
  function render(st) {
    latestUpdates = st.updates || [];
    latestPhase = st.phase;
    // header
    $('phase').textContent =
      st.phase === 'done' ? (st.fail ? `${st.done} updated, ${st.fail} failed` : `${st.done} steps completed`)
                          : `${st.done + st.skip + st.fail} of ${st.total} steps`;
    $('clock').textContent = fmt(st.elapsed || 0);
    for (const [k, n] of [['done', st.done], ['skip', st.skip], ['fail', st.fail]]) {
      $('c-' + k).textContent = n;
      $('s-' + k).classList.toggle('has', n > 0);   // zero stays quiet, grey
    }

    const pct = st.total ? ((st.done + st.skip + st.fail) / st.total) * 100 : 0;
    spring(() => barPct, (v) => { barPct = v; $('fill').style.width = v + '%'; }, pct, 0.5);

    // Patch only rows that changed. Rebuilding the whole list made every status
    // transition visibly flash and restarted all entrance animations.
    const sig = st.steps.map((s) => s.s + (s.t ?? '')).join('|');
    if (sig !== lastSig) {
      lastSig = sig;
      const list = $('steps');
      st.steps.forEach((s, i) => {
        const key = `${s.s}|${s.t ?? ''}`;
        const old = list.children[i];
        if (old && old.dataset.render === key) {
          if (s.s === 'run') setStepTail(old, st.tail);
          return;
        }
        const box = document.createElement('div');
        box.innerHTML = stepMarkup(s, st);
        const next = box.firstElementChild;
        next.dataset.render = key;
        if (old) {
          if (activeLogEl === old) hideStepLog(old);
          old.replaceWith(next);
        } else {
          list.appendChild(next);
        }
        if (s.s === 'run') setStepTail(next, st.tail);
      });
      while (list.children.length > st.steps.length) list.lastElementChild.remove();
      if (!list.classList.contains('ready') && !stepsReadyTimer) {
        stepsReadyTimer = setTimeout(() => list.classList.add('ready'), 450);
      }
    } else {
      // cheap path: only the running step's clock ticks
      const run = st.steps.findIndex((s) => s.s === 'run');
      if (run >= 0) {
        const el = $('steps').children[run];
        if (el) {
          const took = el.querySelector('.took');
          if (took) took.textContent = fmt(st.elapsed - (st.steps[run].b ?? st.elapsed));
          setStepTail(el, st.tail);
        }
      }
    }

    // result
    if (st.phase === 'done') {
      $('result').classList.add('on');
      // A red cross means "this run achieved nothing". One failed step among many
      // successful ones is a warning, not a failure of the whole run.
      const failed = st.fail > 0, total_fail = failed && st.done === 0;
      $('verdict').hidden = !failed;
      $('verdict').classList.toggle('bad', total_fail);
      $('verdict').classList.toggle('warn', failed && !total_fail);
      if (failed) {
        $('r-mark').innerHTML = total_fail
          ? `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m8 8 8 8M16 8l-8 8"/></svg>`
          : `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 7.5v6M12 16.8v.2"/></svg>`;
        $('r-head').textContent = total_fail ? 'Nothing could be updated'
          : `Done, ${st.fail} step${st.fail === 1 ? '' : 's'} needs attention`;
      }

      const ups = st.updates || [];
      const moved = ups.length;
      const ticket = moved ? String(moved) : 'none';
      if ($('open-ledger').dataset.ticket !== ticket) {
        $('open-ledger').dataset.ticket = ticket;
        const arrow = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>`;
        const label = moved === 1 ? 'tool updated' : moved ? 'tools updated' : 'Nothing updated';
        $('open-ledger').innerHTML = moved
          ? `<b>${moved}</b><span class="copy"><strong>${label}</strong><small>Click to see</small></span>${arrow}`
          : `<span class="copy"><strong>${label}</strong><small>Click to see</small></span>${arrow}`;
      }
      $('ledger-facts').innerHTML = [
        [st.done, 'completed'],
        [st.skip, 'skipped'],
        ...(st.fail ? [[st.fail, 'failed']] : []),
        [fmt(st.elapsed), 'elapsed'],
      ].map(([n, k]) => `<span><b>${n}</b>${k}</span>`).join('');
      $('ledger-title').textContent = failed
        ? $('r-head').textContent
        : (ups.length ? 'What changed' : 'Nothing changed');
      $('ledger-empty').hidden = ups.length > 0;
      $('ledger-list').innerHTML = ups.map((u) => `
        <li>
          ${logo(u.slug, u.img, u.n)}
          <span class="name">${escapeHtml(u.n)}</span>
          ${versionMarkup(u.o, u.w)}
        </li>`).join('');
      if (!ledgerShown) { ledgerShown = true; openLedger(); }
      document.title = st.fail ? `updatetools — ${st.fail} failed` : 'updatetools — done';
    } else {
      document.title = `updatetools — ${Math.round(pct)}%`;
    }
  }

  /* ── per-step output: the log is one file, split on the run's own banners ─── */
  const hoverLogs = matchMedia('(hover: hover) and (pointer: fine)').matches;
  let activeLogEl = null, logToken = 0, openedAt = 0;
  let hoverEl = null, hoverOpenTimer = 0;
  let ledgerShown = false;
  function openLedger() {
    const el = $('ledger');
    el.hidden = false;
    el.classList.remove('hide', 'show');
    void el.offsetWidth;
    el.classList.add('show');
  }
  function closeLedger() {
    const el = $('ledger');
    if (el.hidden || el.classList.contains('hide')) return;
    el.classList.add('hide');
    el.classList.remove('show');
    if (reduce) {
      el.hidden = true;
      el.classList.remove('hide');
    }
  }
  let logText = '', logAt = 0;
  async function fetchLog() {
    if (Date.now() - logAt < 800) return logText;
    try {
      logText = await (await fetch('log.txt?t=' + Date.now(), { cache: 'no-store' })).text();
      logAt = Date.now();
    } catch { /* server gone: keep what we have */ }
    return logText;
  }
  function sliceFor(label) {
    const parts = logText.split(/^######## (.+?) ########$/m);
    for (let i = 1; i < parts.length; i += 2) {
      if (parts[i].trim() === label.trim()) return parts[i + 1].trim();
    }
    return '';
  }
  function reportMarkdown() {
    if (latestPhase !== 'done') return '# Report\n\n_Collecting version changes…_';
    if (!latestUpdates.length) return '# Report\n\n_No version changes detected in this run._';
    return ['# Report', '', '## Updated', '', ...latestUpdates.map(
      (u) => `- **${u.n}**: \`${u.o}\` → \`${u.w}\``
    )].join('\n');
  }
  function logToMarkdown(raw) {
    const lines = (raw || '').split(/\r?\n/);
    const out = [];
    for (const line of lines) {
      const t = line.trim();
      if (!t) { out.push(''); continue; }
      if (/^[#O=\-\s.]{4,}$/.test(t)) continue;
      if (/^#{3,}/.test(t)) continue;
      const arrow = t.match(/^>>\s+(.+?):\s+(.+)$/);
      if (arrow) {
        const detail = arrow[2].replace(/(\S+)\s+→\s+(\S+)/, '`$1` → `$2`');
        out.push(`- **${arrow[1]}** — ${detail}`);
        continue;
      }
      if (/^already up to date/i.test(t) || /^manual apps:\s*already up to date/i.test(t)) {
        out.push('Already up to date.');
        continue;
      }
      const summary = t.match(/^manual apps:\s*(.+)$/i);
      if (summary) { out.push(summary[1]); continue; }
      if (/^(installed atomically|app is running|download failed|checksum mismatch|not a mountable|could not schedule|staged copy|bundle ID|already current)/i.test(t)) {
        out.push(`- ${t}`);
        continue;
      }
      out.push(t);
    }
    return out.join('\n').replace(/\n{3,}/g, '\n\n').trim();
  }
  function versionMarkup(oldV, newV) {
    const oldS = String(oldV ?? '');
    const newS = String(newV ?? '');
    const a = oldS.split('.');
    const b = newS.split('.');
    let i = 0;
    while (i < a.length && i < b.length && a[i] === b[i]) i++;
    const paint = (parts) => parts.map((part, idx) => {
      const bit = idx >= i ? `<em>${escapeHtml(part)}</em>` : escapeHtml(part);
      return (idx ? '.' : '') + bit;
    }).join('');
    return `<span class="ver" aria-label="${escapeHtml(oldS)} to ${escapeHtml(newS)}"><span class="from">${paint(a)}</span><span class="move" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg></span><span class="to">${paint(b)}</span></span>`;
  }
  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, (c) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
    }[c]));
  }
  function inlineMd(s) {
    return escapeHtml(s)
      .replace(/`([^`]+)`/g, '<code>$1</code>')
      .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
      .replace(/_([^_]+)_/g, '<em>$1</em>');
  }
  function renderMiniMarkdown(src) {
    const lines = String(src || '').split('\n');
    let html = '';
    let list = [];
    const flush = () => {
      if (!list.length) return;
      html += `<ul>${list.map((x) => `<li>${inlineMd(x)}</li>`).join('')}</ul>`;
      list = [];
    };
    for (const raw of lines) {
      const line = raw.trimEnd();
      if (!line.trim()) { flush(); continue; }
      if (/^# /.test(line)) { flush(); html += `<h4>${inlineMd(line.slice(2))}</h4>`; continue; }
      if (/^## /.test(line)) { flush(); html += `<h5>${inlineMd(line.slice(3))}</h5>`; continue; }
      if (/^[-*] /.test(line)) { list.push(line.slice(2)); continue; }
      flush();
      html += `<p>${inlineMd(line)}</p>`;
    }
    flush();
    return html || '<p class="md-empty">No output yet</p>';
  }
  async function showStepLog(el, label) {
    if (activeLogEl === el && el.querySelector('.note')) return;
    hideStepLog();
    const token = ++logToken;
    activeLogEl = el;
    el.classList.add('open');
    await fetchLog();
    if (token !== logToken || activeLogEl !== el || !el.isConnected) return;
    const isReport = label.startsWith('Report');
    const md = isReport ? reportMarkdown() : logToMarkdown(sliceFor(label));
    const note = document.createElement('div');
    note.className = 'note';
    note.innerHTML = `<div class="note-in"><div class="log-md"></div></div>`;
    note.querySelector('.log-md').innerHTML = renderMiniMarkdown(md);
    el.appendChild(note);
    openedAt = Date.now();
    requestAnimationFrame(() => note.classList.add('on'));
  }
  function hideStepLog(el = activeLogEl, instant = false) {
    if (!el) return;
    logToken++;
    const note = el.querySelector('.note');
    el.classList.remove('open');
    if (activeLogEl === el) activeLogEl = null;
    if (!note) return;
    const young = Date.now() - openedAt < 280;
    if (instant || young || reduce) { note.remove(); return; }
    note.classList.remove('on');
    const drop = () => { if (note.isConnected) note.remove(); };
    note.addEventListener('transitionend', drop, { once: true });
    setTimeout(drop, 380);
  }
  function toggleStepLog(el, label) {
    if (activeLogEl === el) hideStepLog(el);
    else showStepLog(el, label);
  }

  /* ── files + the log, rendered once and kept in sync ─────────────────────── */
  let filesSig = '';
  function renderFiles(st) {
    // A normal run keeps nothing on disk, so there is nothing to link to; paths
    // only appear when --debug asked for the log and the report to be kept.
    if (!st.debug) { $('files').innerHTML = ''; return; }
    const sig = (st.report || '') + '|' + (st.log || '');
    if (sig === filesSig) return;
    filesSig = sig;
    const row = (kind, path, extra) => `
      <div class="file">
        <span class="k">${kind}</span>
        <span class="p" title="${path}">${path}</span>
        <span class="act">
          <button class="btn" data-copy="${path}">Copy path</button>
          ${extra}
        </span>
      </div>`;
    const rows = [];
    if (st.report) rows.push(row('report', st.report, `<a class="btn" href="report.html" target="_blank" rel="noopener">Open</a>`));
    if (st.log) rows.push(row('log', st.log, `<button class="btn" id="toggle-log">View</button>`));
    $('files').innerHTML = rows.join('');

    $('files').onclick = async (e) => {
      const c = e.target.closest('[data-copy]');
      if (c) {
        try {
          await navigator.clipboard.writeText(c.dataset.copy);
          const was = c.textContent; c.textContent = 'Copied'; c.classList.add('done');
          setTimeout(() => { c.textContent = was; c.classList.remove('done'); }, 1400);
        } catch { /* clipboard blocked — the path is selectable anyway */ }
        return;
      }
      if (e.target.id === 'toggle-log') {
        const box = $('logbox');
        box.hidden = !box.hidden;
        e.target.textContent = box.hidden ? 'View' : 'Hide';
        if (!box.hidden) loadLog();
      }
    };
  }

  async function loadLog() {
    if ($('logbox').hidden) return;
    try {
      const r = await fetch('log.txt?t=' + Date.now(), { cache: 'no-store' });
      const txt = await r.text();
      const pre = $('logtext');
      const stick = pre.scrollTop + pre.clientHeight >= pre.scrollHeight - 8;
      pre.textContent = txt;
      if (stick) pre.scrollTop = pre.scrollHeight;   // follow the tail unless scrolled up
    } catch { /* server gone */ }
  }


  /* ── auth sheet: keystrokes stay in a JS buffer; while hidden, the DOM only
     contains one bullet per character.
     Not type=password and not named like a login field. A decoy form absorbs
     browser password-manager heuristics; the visible control is contenteditable.
     A page-wide keylogger still can. ── */
  let asking = false;
  let chal = [];
  let revealed = false;
  let hideTimer = 0;
  const HIDE_AFTER = 120000;
  const scrim = $('scrim'), sheet = $('pwform'), chalInput = $('ut-chal'), eyeBtn = $('ut-chal-eye');
  function paintChal() {
    chalInput.textContent = revealed ? chal.join('') : '•'.repeat(chal.length);
    if (asking && document.activeElement === chalInput) placeCaretEnd();
  }
  function placeCaretEnd() {
    const range = document.createRange();
    range.selectNodeContents(chalInput);
    range.collapse(false);
    const sel = window.getSelection();
    sel.removeAllRanges();
    sel.addRange(range);
    chalInput.scrollLeft = chalInput.scrollWidth;
  }
  function setEditable(on) { chalInput.setAttribute('contenteditable', on ? 'true' : 'false'); }
  function setRevealed(on) {
    revealed = on;
    sheet.classList.toggle('reveal', on);
    eyeBtn.setAttribute('aria-pressed', on ? 'true' : 'false');
    eyeBtn.setAttribute('aria-label', on ? 'Hide password' : 'Show password');
    clearTimeout(hideTimer);
    paintChal();
    if (on) {
      hideTimer = setTimeout(() => setRevealed(false), HIDE_AFTER);
    }
  }
  function chalClear() {
    chal = [];
    setRevealed(false);
  }
  function askPassword(prompt) {
    if (asking) return;
    asking = true;
    $('pw-title').textContent = /again|wrong|sorry/i.test(prompt) ? 'try again' : 'sudo';
    chalClear();
    scrim.classList.add('on');
    setTimeout(() => { setEditable(true); chalInput.focus(); placeCaretEnd(); }, 50);
  }
  function hidePassword() {
    asking = false;
    scrim.classList.remove('on');
    chalClear();
    setEditable(false);
  }
  async function submitChal() {
    const reply = chal.join('');
    hidePassword();
    try {
      await fetch('prompt', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ reply }),
      });
    } catch { /* the run will time out on its own */ }
  }
  function noteActivity() {
    if (!revealed) return;
    clearTimeout(hideTimer);
    hideTimer = setTimeout(() => setRevealed(false), HIDE_AFTER);
  }
  chalInput.addEventListener('focus', () => {
    if (!asking) return;
    setEditable(true);
    placeCaretEnd();
  });
  $('ut-chal-form').addEventListener('submit', (e) => { e.preventDefault(); submitChal(); });
  chalInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') { e.preventDefault(); submitChal(); return; }
    if (e.key === 'Backspace') { e.preventDefault(); chal.pop(); paintChal(); noteActivity(); return; }
    if (e.metaKey || e.ctrlKey) {
      if (e.key === 'v' || e.key === 'V') return;
      e.preventDefault();
      return;
    }
    if (e.key.length === 1) { e.preventDefault(); chal.push(e.key); paintChal(); noteActivity(); }
  });
  chalInput.addEventListener('paste', (e) => {
    e.preventDefault();
    const t = (e.clipboardData && e.clipboardData.getData('text')) || '';
    for (const c of t) if (c !== '\n' && c !== '\r') chal.push(c);
    paintChal();
    noteActivity();
  });
  chalInput.addEventListener('beforeinput', (e) => e.preventDefault());
  chalInput.addEventListener('input', paintChal);
  eyeBtn.addEventListener('click', () => setRevealed(!revealed));
  $('ut-chal-go').addEventListener('click', submitChal);
  const infoBtn = sheet.querySelector('.info');
  const tipOn = (on) => infoBtn.classList.toggle('open', on);
  infoBtn.addEventListener('mouseenter', () => tipOn(true));
  infoBtn.addEventListener('mouseleave', () => tipOn(false));
  infoBtn.addEventListener('focus', () => tipOn(true));
  infoBtn.addEventListener('blur', () => tipOn(false));

  $('steps').addEventListener('pointerover', (e) => {
    const el = e.target.closest('.step');
    if (!hoverLogs || !el || el.contains(e.relatedTarget)) return;
    clearTimeout(hoverOpenTimer);
    hoverEl = el;
    if (activeLogEl === el) return;
    hoverOpenTimer = setTimeout(() => {
      hoverOpenTimer = 0;
      if (hoverEl === el && el.isConnected) showStepLog(el, el.dataset.label);
    }, 160);
  });
  $('steps').addEventListener('pointerout', (e) => {
    const el = e.target.closest('.step');
    if (!hoverLogs || !el || el.contains(e.relatedTarget)) return;
    if (hoverEl === el) {
      hoverEl = null;
      clearTimeout(hoverOpenTimer);
      hoverOpenTimer = 0;
    }
    if (activeLogEl === el) hideStepLog(el);
  });
  $('steps').addEventListener('wheel', (e) => {
    const box = e.target.closest('.log-md');
    if (!box) return;
    e.preventDefault();
    const max = box.scrollHeight - box.clientHeight;
    box.scrollTop = Math.min(max, Math.max(0, box.scrollTop + e.deltaY));
  }, { passive: false });
  $('steps').addEventListener('focusin', (e) => {
    const el = e.target.closest('.step');
    if (el) showStepLog(el, el.dataset.label);
  });
  $('steps').addEventListener('focusout', (e) => {
    const el = e.target.closest('.step');
    if (!el || el.contains(e.relatedTarget)) return;
    hideStepLog(el);
  });
  $('steps').addEventListener('click', (e) => {
    if (hoverLogs) return;
    const el = e.target.closest('.step');
    if (el) toggleStepLog(el, el.dataset.label);
  });
  $('steps').addEventListener('keydown', (e) => {
    if (e.key !== 'Enter' && e.key !== ' ') return;
    const el = e.target.closest('.step');
    if (el) { e.preventDefault(); toggleStepLog(el, el.dataset.label); }
  });

  let misses = 0;
  $('open-ledger').addEventListener('click', openLedger);
  $('ledger-back').addEventListener('click', closeLedger);
  $('ledger').addEventListener('animationend', (e) => {
    if (e.animationName !== 'unbuff') return;
    const el = $('ledger');
    if (!el.classList.contains('hide')) return;
    el.hidden = true;
    el.classList.remove('hide');
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !$('ledger').hidden) closeLedger();
  });
  async function poll() {
    try {
      const r = await fetch('state.json?t=' + Date.now(), { cache: 'no-store' });
      const st = await r.json();
      misses = 0;
      render(st);
      renderFiles(st);
      if (st.prompt) askPassword(st.prompt); else if (asking) hidePassword();
      loadLog();
      if (st.phase === 'done') { setTimeout(poll, 2000); return; }
    } catch (e) {
      // the run exits and takes the server with it; nothing to announce
      misses++;
    }
    setTimeout(poll, 400);
  }
  poll();
})();
</script>
</body>
</html>
WEB_HTML_TAIL
