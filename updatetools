# ut_web_state PHASE — write state.json atomically (the page may read at any time).
# Globals it reads: STEPS/STATUS/STEP_T0/STEP_SEC/TOTAL/T0/LOG/UT_WEB_UPDATES.
ut_web_state() {
  [ -n "$WEB_DIR" ] || return 0
  local phase="${1:-run}" i done_n=0 skip_n=0 fail_n=0 steps="" tail_line="" label name action slug
  for ((i=0;i<TOTAL;i++)); do
    case "${STATUS[i]}" in done) done_n=$((done_n+1));; skip) skip_n=$((skip_n+1));; fail) fail_n=$((fail_n+1));; esac
    label="${STEPS[i]%%¦*}"; name="$label"; action=""
    if [[ "$label" == *" · "* ]]; then name="${label%% · *}"; action="${label#* · }"; fi
    slug="${STEP_SLUG[i]:-}"
    [ -n "$steps" ] && steps+=","
    steps+="{\"n\":\"$(ut_json_escape "$name")\",\"a\":\"$(ut_json_escape "$action")\",\"s\":\"${STATUS[i]}\""
    steps+=",\"slug\":\"$slug\""
    [ -n "${STEP_IMG[i]:-}" ] && steps+=",\"img\":\"${STEP_IMG[i]}\""
    [ -n "${STEP_SEC[i]:-}" ] && steps+=",\"t\":${STEP_SEC[i]}"
    [ -n "${STEP_T0[i]:-}" ]  && steps+=",\"b\":$(( ${STEP_T0[i]} - T0 ))"
    steps+="}"
  done
  if [ "$phase" != "done" ]; then
    tail_line=$(
      tail -n 40 "$LOG" 2>/dev/null | tr -d '\r' \
        | LC_ALL=C sed $'s/\033\\[[0-9;?]*[a-zA-Z]//g' \
        | awk '
            /^[ \t]*$/ { next }
            /^#{2,}/ { next }
            /^[#O=. \t-]{4,}$/ { next }
            { line = $0 }
            END { print line }
          ' | cut -c1-160
    )
  fi
  # The page can open any step's output, so the log is always mirrored into the
  # served dir (it is temporary either way and goes when the run ends).
  tr -d '\r' < "$LOG" 2>/dev/null \
    | LC_ALL=C sed $'s/\033\\[[0-9;?]*[a-zA-Z]//g' > "$WEB_DIR/.log.tmp" 2>/dev/null \
    && mv -f "$WEB_DIR/.log.tmp" "$WEB_DIR/log.txt" 2>/dev/null
  if [ "${DEBUG:-0}" = "1" ] && [ -n "${UT_WEB_REPORT:-}" ] && [ -f "$UT_WEB_REPORT" ]; then
    cp -f "$UT_WEB_REPORT" "$WEB_DIR/report.html" 2>/dev/null
  fi
  {
    printf '{"phase":"%s","elapsed":%d,"total":%d,"done":%d,"skip":%d,"fail":%d' \
      "$phase" "$((SECONDS-T0))" "$TOTAL" "$done_n" "$skip_n" "$fail_n"
    printf ',"tail":"%s"' "$(ut_json_escape "$tail_line")"
    [ -n "${UT_PROMPT:-}" ] && printf ',"prompt":"%s"' "$(ut_json_escape "$UT_PROMPT")"
    printf ',"debug":%s' "$([ "${DEBUG:-0}" = "1" ] && echo true || echo false)"
    [ "${DEBUG:-0}" = "1" ] && printf ',"log":"%s"' "$(ut_json_escape "$LOG")"
    [ "${DEBUG:-0}" = "1" ] && [ -n "${UT_WEB_REPORT:-}" ] && printf ',"report":"%s"' "$(ut_json_escape "$UT_WEB_REPORT")"
    printf ',"steps":[%s]' "$steps"
    [ -n "${UT_WEB_UPDATES:-}" ] && printf ',"updates":[%s]' "$UT_WEB_UPDATES"
    printf '}\n'
  } > "$WEB_DIR/.state.tmp" && mv -f "$WEB_DIR/.state.tmp" "$WEB_DIR/state.json"
}

# ut_web_updates DATA_FILE — turn the report's records into the JSON the page
# shows in its "after" section (same logos and vendor names as the HTML report).
ut_web_updates() {
  local f=${1-} key display old new url slug img out=""
  [ -r "$f" ] || return 0
  while IFS='|' read -r key display old new url || [ -n "${key:-}" ]; do
    [ -n "${key:-}" ] || continue
    display=$(ut_pretty_name "$key" "${display:-$key}")
    slug="$(ut_icon_slug "$display")"
    img=""
    if [ -z "$slug" ]; then
      local home; home=$(ut_icon_homepage "$key") && img=$(ut_icon_datauri "$home") || img=""
    fi
    [ -n "$out" ] && out+=","
    out+="{\"n\":\"$(ut_json_escape "$display")\",\"o\":\"$(ut_json_escape "${old%%,*}")\""
    out+=",\"w\":\"$(ut_json_escape "${new%%,*}")\",\"slug\":\"$slug\""
    [ -n "$img" ] && out+=",\"img\":\"$img\""
    out+="}"
  done < "$f"
  printf '%s' "$out"
}

# ut_web_ask PROMPT — ask for a password in the browser and wait for the answer.
# The page posts it back to the local server, which writes it straight to the
# askpass reply file; nothing is typed into, or echoed by, the terminal.
ut_web_ask() {
  local waited=0 limit=$(( ${PROMPT_TIMEOUT:-300} * 5 ))
  # Already answered once this run? Reuse it instead of asking again — brew calls
  # sudo once per cask, and an unnoticed second prompt just times the step out.
  if [ -n "${SUDO_PW:-}" ] && [ "${2:-}" != "force" ]; then
    ( umask 077; printf '%s\n' "$SUDO_PW" > "$PROMPT_REP" )
    return 0
  fi
  UT_PROMPT="${1:-Password:}"
  rm -f "$PROMPT_REP"
  ut_web_state run
  while [ ! -s "$PROMPT_REP" ]; do
    sleep 0.2
    waited=$((waited+1))
    if [ "$waited" -gt "$limit" ]; then UT_PROMPT=""; ut_web_state run; return 1; fi
    # the tab was closed / server gone: nobody can answer any more
    kill -0 "$WEB_PID" 2>/dev/null || { UT_PROMPT=""; return 1; }
  done
  UT_PROMPT=""
  SUDO_PW=$(cat "$PROMPT_REP" 2>/dev/null)   # in memory only, never written out
  ut_web_state run
  return 0
}

# ut_web_start — serve the page on a free port and open it. Returns 1 if we
# can't (no python3), so the caller can fall back to plain output.
ut_web_start() {
  have python3 || return 1
  WEB_DIR=$(mktemp -d "${TMPDIR:-/tmp}/updatetools-web.XXXXXX") || return 1
  ut_web_page > "$WEB_DIR/index.html" || return 1
  ut_web_state "run"

  # http.server with a no-store header, so a poll never reads a cached snapshot.
  cat > "$WEB_DIR/serve.py" <<'SERVE_EOF'
# Local dashboard server.
#
# Access control, in layers:
#   1. bound to 127.0.0.1 only — never reachable from the network
#   2. a random token: the opened URL carries ?k=…, which is exchanged for a
#      HttpOnly cookie. Without it every request is 403, so another user on this
#      Mac (or a random page in your browser) can't read the run or post to it.
#   3. Host header must be loopback — blocks DNS-rebinding, where an external
#      site resolves a name to 127.0.0.1 and talks to us from the victim's browser
#   4. the password goes over this loopback socket only, and is written straight
#      to the askpass reply file; it is never stored or echoed anywhere
import http.server, socketserver, sys, os, threading, time, json, http.cookies

root, token_file, reply_file, idle_timeout = sys.argv[1], sys.argv[2], sys.argv[3], float(sys.argv[4])
# The token arrives in a 0600 file, not on the command line — argv is visible to
# every user on the machine via ps, which would defeat the point of having one.
with open(token_file) as f:
    token = f.read().strip()
os.unlink(token_file)
os.chdir(root)
state = {'last': time.time(), 'quit': False}

class H(http.server.SimpleHTTPRequestHandler):
    def _authed(self):
        host = (self.headers.get('Host') or '').split(':')[0]
        if host not in ('127.0.0.1', 'localhost', '[::1]', '::1'):
            return False
        if ('?k=' + token) in self.path or ('&k=' + token) in self.path:
            return True
        raw = self.headers.get('Cookie')
        if raw:
            c = http.cookies.SimpleCookie(raw)
            if 'ut' in c and c['ut'].value == token:
                return True
        return False

    def _deny(self):
        self.send_response(403); self.send_header('Content-Length', '0'); self.end_headers()

    def end_headers(self):
        self.send_header('Cache-Control', 'no-store, must-revalidate')
        self.send_header('Referrer-Policy', 'no-referrer')
        self.send_header('X-Content-Type-Options', 'nosniff')
        super().end_headers()

    def do_GET(self):
        state['last'] = time.time()
        if not self._authed():
            return self._deny()
        if self.path.startswith('/?k=') or self.path == '/?k=' + token:
            # first visit: swap the URL token for a cookie, then drop it from the
            # address bar so the token isn't left sitting in history
            self.send_response(302)
            self.send_header('Set-Cookie', f'ut={token}; Path=/; HttpOnly; SameSite=Strict')
            self.send_header('Location', '/')
            self.send_header('Content-Length', '0')
            self.end_headers()
            return
        self.path = self.path.split('?')[0]
        return super().do_GET()

    def do_POST(self):
        state['last'] = time.time()
        if not self._authed():
            return self._deny()
        path = self.path.split('?')[0]
        length = int(self.headers.get('Content-Length') or 0)
        body = self.rfile.read(length) if length else b''
        if path == '/prompt':
            try:
                payload = json.loads(body.decode('utf-8'))
                pw = payload.get('reply', '') or payload.get('password', '')
            except Exception:
                pw = ''
            # 0600 from the start: the reply file briefly holds the password
            fd = os.open(reply_file, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, 'w') as f:
                f.write(pw + '\n')
            self.send_response(204); self.send_header('Content-Length', '0'); self.end_headers()
            return
        if path == '/quit':
            state['quit'] = True
            self.send_response(204); self.send_header('Content-Length', '0'); self.end_headers()
            return
        self._deny()

    def log_message(self, *a): pass

class Server(socketserver.ThreadingTCPServer):
    daemon_threads = True
    allow_reuse_address = True

with Server(('127.0.0.1', 0), H) as srv:
    print(srv.server_address[1], flush=True)
    # The run has no terminal UI to quit from, so the page's lifetime ends the
    # server: close the tab (polling stops) or press Close, and we shut down.
    def watch():
        while True:
            time.sleep(1)
            if state['quit'] or time.time() - state['last'] > idle_timeout:
                srv.shutdown(); return
    threading.Thread(target=watch, daemon=True).start()
    srv.serve_forever()
SERVE_EOF

  # 128-bit token from the kernel's CSPRNG; the page trades it for a cookie.
  # via python (already required here): `tr -dc … < /dev/urandom | head -c 32`
  # can hang, since tr keeps reading the endless device after head has gone.
  WEB_TOKEN=$(python3 -c 'import secrets; print(secrets.token_hex(16))' 2>/dev/null)
  [ -n "$WEB_TOKEN" ] || return 1
  chmod 700 "$WEB_DIR" 2>/dev/null
  local tokfile="$WEB_DIR/.token"
  ( umask 077; printf '%s' "$WEB_TOKEN" > "$tokfile" )
  python3 "$WEB_DIR/serve.py" "$WEB_DIR" "$tokfile" "$PROMPT_REP" "${WEB_IDLE:-20}" \
    > "$WEB_DIR/port" 2>/dev/null &
  WEB_PID=$!
  local tries=0 port=""
  while [ $tries -lt 50 ]; do
    port=$(head -1 "$WEB_DIR/port" 2>/dev/null)
    [ -n "$port" ] && break
    sleep 0.1; tries=$((tries+1))
  done
  [ -n "$port" ] || { kill "$WEB_PID" 2>/dev/null; WEB_PID=""; return 1; }
  WEB_URL="http://127.0.0.1:$port/?k=$WEB_TOKEN"
  if open "$WEB_URL" 2>/dev/null; then WEB_OPENED=1; else WEB_OPENED=0; fi
  return 0
}

ut_web_stop() {
  [ -n "$WEB_PID" ] && kill "$WEB_PID" 2>/dev/null
  WEB_PID=""
  [ -n "$WEB_DIR" ] && rm -rf "$WEB_DIR" 2>/dev/null
  WEB_DIR=""
}

npm_update_global() {
  # npm itself lives in /opt/homebrew and is brew-managed; npm update -g includes it
  # and fails with EACCES. Update only non-npm packages explicitly.
  local pkgs
  pkgs=$(npm outdated -g --depth=0 --parseable 2>/dev/null \
    | cut -d: -f4 | sed 's/@[^@]*$//' | grep -v '^npm$' | tr '\n' ' ')
  [ -n "$pkgs" ] && npm install -g $pkgs || true
  # Cache may have root-owned files from an old npm bug; verify non-fatally.
  npm cache verify || true
}

# Codex CLI - npm is the ONE supported install source here.
#
# Codex must never update itself: `codex update` and its startup update check
# pull in whatever OpenAI currently ships under that name (the July 2026
# reshuffle renamed the desktop app and moved Codex into ChatGPT.app), which
# silently changes what is installed on this Mac. Self-update is disabled via
# `check_for_update_on_startup = false` in ~/.codex/config.toml; this function is
# the only path that bumps the CLI. A missing npm install is an error, not a cue
# to guess at another source.
codex_update_npm_only() {
  if have npm && npm ls -g @openai/codex >/dev/null 2>&1; then
    npm install -g @openai/codex@latest
  else
    echo "ERROR: codex is on PATH but not installed via 'npm -g @openai/codex'." >&2
    echo "       Reinstall it with: npm install -g @openai/codex@latest" >&2
    echo "       (no fallback: codex is never allowed to update itself)" >&2
    return 1
  fi
}

pnpm_update_global() {
  pnpm self-update 2>/dev/null || brew upgrade pnpm 2>/dev/null || true
  # pnpm's global bin dir may not be in PATH when launched non-interactively.
  local pnpm_bin
  pnpm_bin="$(pnpm config get global-bin-dir 2>/dev/null)"
  [ -n "$pnpm_bin" ] && export PATH="$PATH:$pnpm_bin"
  pnpm update -g --latest || true
}

# Cask upgrades go through ut_upgrade_casks_smart() above,
# which classifies each running app (close vs protect) instead of blanket
# --no-quit staging. The interactive-sudo skip list (BREW_CASK_SKIP, default
# "stats aldente") is still honoured there.

# Locally-developed VS Code extensions (your own publisher) aren't on the
# Marketplace, so `code --install-extension` can't fetch them and errors every
# run. Skip them. Extended-regex matched against publisher.name; override with
# VSCODE_SKIP_EXTS (empty string disables skipping).
VSCODE_SKIP_EXTS="${VSCODE_SKIP_EXTS-^mythler\.}"
vscode_cli() {
  NODE_NO_WARNINGS=1 NODE_OPTIONS="${NODE_OPTIONS:+$NODE_OPTIONS }--no-deprecation" \
    code "$@"
}
vscode_quiet() {
  # Cursor/VS Code's CLI still prints Node url.parse deprecations and a
  # per-extension "Installing extensions..." banner even when nothing changes.
  vscode_cli "$@" 2>&1 | grep -vE \
    'DeprecationWarning|url\.parse\(\)|trace-deprecation|^Installing extensions|already installed' \
    || true
}
vscode_update_exts() {
  local e listed n=0 skip=0
  listed="$(vscode_cli --list-extensions 2>/dev/null | sed '/^[[:space:]]*$/d')"
  [ -n "$listed" ] || { echo "no extensions installed"; return 0; }
  while IFS= read -r e; do
    [ -n "$e" ] || continue
    if [ -n "$VSCODE_SKIP_EXTS" ] && printf '%s' "$e" | grep -qE "$VSCODE_SKIP_EXTS"; then
      echo "skip (local/private, not on marketplace): $e"
      skip=$((skip+1))
      continue
    fi
    n=$((n+1))
  done <<< "$listed"
  vscode_quiet --update-extensions
  echo "vscode: $n marketplace extension(s) checked · $skip skipped"
  return 0
}

LOG="${TMPDIR:-/tmp}/updatetools-$$.log"
: > "$LOG"

# ---------------------------------------------------------------------------
# Step table:  "label¦guard¦command"
#   guard : shell test; if it fails the step is marked SKIP and not run
#   command : the actual work (stdout+stderr -> log)
# ---------------------------------------------------------------------------
STEPS=(
  "Homebrew · update everything¦have brew¦ut_update_homebrew_all"
  "Applications · manual DMGs¦have brew && [ \"\$QUIET_APPS\" = \"1\" ]¦ut_update_manual_apps"
  "npm · global packages¦have npm¦npm_update_global"
  "pnpm · global packages¦have pnpm¦pnpm_update_global"
  "uv · self + tools¦have uv¦{ uv self update 2>/dev/null||brew upgrade uv 2>/dev/null; }; uv tool upgrade --all 2>/dev/null||true"
  "cargo · update binaries¦have cargo¦{ have cargo-install-update||cargo install cargo-update; }; cargo install-update -a"
  "Supabase CLI¦have supabase¦if have brew && brew list supabase >/dev/null 2>&1; then brew upgrade supabase; elif have npm; then npm install -g supabase@latest; fi"
  "Vercel CLI¦have vercel¦if have brew && brew list vercel-cli >/dev/null 2>&1; then brew upgrade vercel-cli; elif have npm && npm list -g vercel >/dev/null 2>&1; then npm install -g vercel@latest; else echo 'vercel present but no known update source matched'; fi"
  "Claude Code · self-update¦have claude¦claude update"
  "Codex CLI · update¦have codex¦codex_update_npm_only"
  "Antigravity · agy update¦have agy¦agy update"
  "gh · extensions¦have gh¦gh extension upgrade --all"
  "VS Code · extensions¦have code¦vscode_update_exts"
  "Report · what changed¦true¦ut_report_finish"
)

TOTAL=${#STEPS[@]}
STATUS=()                       # done|skip|fail|run|pending per step
for ((i=0;i<TOTAL;i++)); do STATUS[i]="pending"; done
# ===========================================================================
# Runtime
# ===========================================================================
T0=$SECONDS
LOG="${TMPDIR:-/tmp}/updatetools-$$.log"
STATUS=(); STEP_T0=(); STEP_SEC=(); STEP_SLUG=(); STEP_IMG=()
CUR_STEP=0; CUR_PID=""
SUDO_KEEPER=""; WRAP_DIR=""; PROMPT_REQ=""; PROMPT_REP=""; LOCKDIR=""
UT_WEB_REPORT=""; UT_WEB_UPDATES=""; SUDO_PW=""; UT_PROMPT=""
UT_WEB_DATA="${TMPDIR:-/tmp}/updatetools-updates-$$.txt"
export UT_WEB_DATA

fmt_time() { printf '%02d:%02d' $(( $1/60 )) $(( $1%60 )); }

# Idempotent: runs on INT/TERM/HUP, on EXIT, and explicitly at the end.
CLEANED=""
cleanup() {
  [ -n "$CLEANED" ] && return; CLEANED=1
  [ -n "$SUDO_KEEPER" ] && kill "$SUDO_KEEPER" 2>/dev/null
  [ -n "$WRAP_DIR" ] && rm -rf "$WRAP_DIR" 2>/dev/null
  [ -n "$LOCKDIR" ] && rm -rf "$LOCKDIR" 2>/dev/null
  [ -n "${UT_LASTREPORT:-}" ] && rm -f "$UT_LASTREPORT" 2>/dev/null
  [ -n "${UT_REPORT_DIR:-}" ] && rm -rf "$UT_REPORT_DIR" 2>/dev/null
  SUDO_PW=""
  rm -f "$UT_WEB_DATA" 2>/dev/null
  # The log is scratch space for the dashboard, not an artefact — unless --debug.
  [ "${DEBUG:-0}" = "1" ] || rm -f "$LOG" 2>/dev/null
  ut_web_stop
}
trap 'cleanup; echo; echo "Interrupted. Full log: '"$LOG"'"; exit 130' INT TERM
trap 'cleanup' EXIT
# Closing the terminal sends SIGHUP: end the run and take the current step's
# process tree with it — brew ignores HUP (we set that), so it would otherwise be
# left orphaned, parked on a password prompt nobody can answer.
trap '[ -n "${CUR_PID:-}" ] && kill_tree "$CUR_PID"; cleanup; exit 129' HUP

# Prime sudo before the run so a step doesn't stall on a hidden prompt.
#
# The password is read here with a bounded `read -t`, not by `sudo -v` itself: a
# bare `sudo -v` blocks on its own tty read, and bash defers traps until the
# foreground command returns — so closing the window left an immortal process.
sudo_prime() {
  sudo -n true 2>/dev/null && return 0
  local i
  for i in 1 2 3; do
    ut_web_ask "$([ "$i" = 1 ] && echo 'Password' || echo 'Wrong password — try again')" force || return 1
    if sudo -S -v < "$PROMPT_REP" 2>/dev/null; then rm -f "$PROMPT_REP"; return 0; fi
    SUDO_PW=""            # it was wrong: don't reuse it for the steps
    rm -f "$PROMPT_REP"
  done
  return 1
}

# ===========================================================================
# Run
# ===========================================================================
run_web() {
  T0=$SECONDS
  LOG="${TMPDIR:-/tmp}/updatetools-$$.log"
  : > "$LOG"
  STATUS=(); STEP_T0=(); STEP_SEC=(); STEP_SLUG=(); STEP_IMG=()
  local i label name
  local site
  for ((i=0;i<TOTAL;i++)); do
    STATUS[i]="pending"
    label="${STEPS[i]%%¦*}"; name="${label%% · *}"
    STEP_SLUG[i]="$(ut_icon_slug "$name")"
    STEP_IMG[i]=""
    if [ -z "${STEP_SLUG[i]}" ]; then
      site="$(ut_icon_site "$name")"
      [ -n "$site" ] && STEP_IMG[i]="$(ut_icon_datauri "$site" 2>/dev/null || true)"
    fi
  done

  # A normal run leaves nothing behind: the dashboard IS the output. The HTML
  # report is still generated — it's where the version diff comes from — but into
  # the served temp dir, and the log is removed at the end. --debug keeps both.
  OPEN_REPORT=0; export OPEN_REPORT


# Create an askpass helper so SSH, Git, and sudo -A prompts from background
# steps get routed through the dashboard instead of blocking on /dev/tty.
# The helper writes the prompt text to a request file and waits for the run loop
# to write a reply file; the render loop below polls and handles it.
WRAP_DIR="${TMPDIR:-/tmp}/updatetools-wrap-$$"
mkdir -p "$WRAP_DIR"
PROMPT_REQ="${WRAP_DIR}/req"
PROMPT_REP="${WRAP_DIR}/rep"
# The request/reply paths are BAKED IN (unquoted heredoc expands them now)
# rather than read from the environment: brew scrubs its subprocess env down to
# an allowlist (HOMEBREW_*, SUDO_ASKPASS, PATH, …), so any custom vars we export
# get stripped before the helper runs — which left it writing to an empty path
# and spinning forever while sudo waited (the dashboard hung on launchctl).
# The wait is bounded: an unbounded `while [ ! -f rep ]` outlived its dashboard
# (closed terminal, killed run) and left helper processes spinning forever with
# a sudo/brew child parked behind them. Give up instead of becoming a zombie.
cat > "${WRAP_DIR}/askpass" <<ASKPASS_EOF
#!/bin/bash
printf '%s' "\${1:-Password: }" > "$PROMPT_REQ"
waited=0
while [ ! -f "$PROMPT_REP" ]; do
  sleep 0.05
  waited=\$((waited+1))
  # give up once the dashboard is gone or the reply never came
  if [ \$((waited % 20)) -eq 0 ] && ! kill -0 $$ 2>/dev/null; then exit 1; fi
  [ "\$waited" -gt $(( (${PROMPT_TIMEOUT:-300} + 30) * 20 )) ] && exit 1
done
cat "$PROMPT_REP"
rm -f "$PROMPT_REP"
ASKPASS_EOF
chmod +x "${WRAP_DIR}/askpass"
export SUDO_ASKPASS="${WRAP_DIR}/askpass"
export SSH_ASKPASS="${WRAP_DIR}/askpass"
export SSH_ASKPASS_REQUIRE="force"
export GIT_ASKPASS="${WRAP_DIR}/askpass"
export GIT_TERMINAL_PROMPT=0

  if ! ut_web_start; then
    echo "Could not start the local dashboard (python3 missing?) — running plain." >&2
    run_plain
    return
  fi
  # The report lands inside the served dir unless we're keeping it.
  [ "${DEBUG:-0}" = "1" ] || UT_REPORT_OUT="$WEB_DIR/report.html"
  export UT_REPORT_OUT
  # The dashboard is the entire UI: the terminal says nothing unless it must
  # (browser wouldn't open, or --debug wants the artefact paths).
  [ "${WEB_OPENED:-0}" = "1" ] || printf 'updatetools dashboard: %s\n' "$WEB_URL"
  [ "${DEBUG:-0}" = "1" ] && printf 'log: %s\n' "$LOG"



  sudo_prime || true
  ( while true; do sleep 55; sudo -n -v 2>/dev/null || break; done ) &
  SUDO_KEEPER=$!

  # With no Homebrew step there is nowhere to take the pre-update snapshot;
  # still capture standalone CLI versions for the final report.
  have brew || ut_report_begin

  local entry guard cmd pid rc stalled last_size last_change size prompt reply
  for ((i=0;i<TOTAL;i++)); do
    CUR_STEP=$i
    entry="${STEPS[i]}"
    guard="${entry#*¦}"; guard="${guard%%¦*}"
    cmd="${entry##*¦}"

    if ! eval "$guard" >/dev/null 2>&1; then
      STATUS[i]="skip"; ut_web_state run; continue
    fi

    STATUS[i]="run"
    STEP_T0[i]=$SECONDS
    ut_web_state run
    rm -f "$PROMPT_REQ" "$PROMPT_REP"
    sudo -n -v 2>/dev/null || true
    {
      # Detach the step from our controlling terminal so an askpass prompt can't
      # deliver SIGHUP/SIGTTIN to brew's process group mid-upgrade.
      trap '' HUP TTIN TTOU
      echo; echo "######## ${entry%%¦*} ########"
      eval "$cmd"
    } >>"$LOG" 2>&1 </dev/null &
    pid=$!
    CUR_PID=$pid

    last_size=$(wc -c < "$LOG" 2>/dev/null); last_size=${last_size// /}
    last_change=$SECONDS
    stalled=0

    while kill -0 "$pid" 2>/dev/null; do
      # A password request surfaces in the dashboard, not here.
      if [ -f "$PROMPT_REQ" ]; then
        prompt=$(cat "$PROMPT_REQ"); rm -f "$PROMPT_REQ"
        if ut_web_ask "${prompt:-Password:}"; then
          last_change=$SECONDS      # don't penalise time spent waiting on the user
        else
          kill_tree "$pid"; sleep 1; kill -KILL "$pid" 2>/dev/null
          echo "######## no password entered within ${PROMPT_TIMEOUT}s — step aborted ########" >> "$LOG"
          stalled=1
          break
        fi
      fi

      # Stall watchdog: no new output for STALL_TIMEOUT seconds => wedged.
      if [ "${STALL_TIMEOUT:-0}" -gt 0 ] 2>/dev/null; then
        size=$(wc -c < "$LOG" 2>/dev/null); size=${size// /}
        if [ "$size" != "$last_size" ]; then
          last_size=$size; last_change=$SECONDS
        elif [ $(( SECONDS - last_change )) -ge "$STALL_TIMEOUT" ]; then
          kill_tree "$pid"; sleep 1; kill -KILL "$pid" 2>/dev/null
          echo "######## stalled ${STALL_TIMEOUT}s with no output — killed ########" >> "$LOG"
          stalled=1
          break
        fi
      fi

      ut_web_state run
      sleep 0.4
    done
    CUR_PID=""
    wait "$pid" 2>/dev/null; rc=$?
    STEP_SEC[i]=$(( SECONDS - ${STEP_T0[i]:-$SECONDS} ))
    if [ "$stalled" = 1 ] || [ "$rc" -ne 0 ]; then STATUS[i]="fail"; else STATUS[i]="done"; fi
    ut_web_state run
  done

  # ── after: counts, the version diff, where things landed ──────────────────
  local done_n=0 skip_n=0 fail_n=0
  for ((i=0;i<TOTAL;i++)); do
    case "${STATUS[i]}" in
      done) done_n=$((done_n+1)) ;;
      skip) skip_n=$((skip_n+1)) ;;
      fail) fail_n=$((fail_n+1)) ;;
    esac
  done
  [ -r "${UT_LASTREPORT:-/nonexistent}" ] && UT_WEB_REPORT="$(cat "$UT_LASTREPORT" 2>/dev/null)"
  [ -r "${UT_WEB_DATA:-/nonexistent}" ] && UT_WEB_UPDATES="$(ut_web_updates "$UT_WEB_DATA")"
  ut_web_state done

  if [ "${DEBUG:-0}" = "1" ]; then
    [ -n "${UT_WEB_REPORT:-}" ] && printf 'report: %s\n' "$UT_WEB_REPORT"
    printf 'log:    %s\n' "$LOG"
  fi

  # No key to press: the page owns the session now. The server exits when the tab
  # is closed (polling stops) or Close is pressed, and this run ends with it.
  wait "$WEB_PID" 2>/dev/null
  ut_web_stop
}

run_plain() {
# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
section() { printf '\n\033[1;36m== %s ==\033[0m\n' "$*"; }
have()    { command -v "$1" >/dev/null 2>&1; }
note()    { printf '   %s\n' "$*"; }

# ---------------------------------------------------------------------------
# Homebrew PATH
# ---------------------------------------------------------------------------
section "Ensure Homebrew PATH"
if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
  eval "$(/usr/local/bin/brew shellenv)"
